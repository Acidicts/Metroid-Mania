<div id="<%= dom_id order %>" class="order-wrap">
  <div class="order-card">
    <div class="order-details">
      <div>
        <strong>Order:</strong>
        <% if order.grant_amount_cents.to_i.positive? %>
          <%= order.name.to_s.sub(/\s+-\s*\$\d+(?:\.\d+)?\z/, '') %>
        <% else %>
          <%= order.name.split(" - ").first %>
        <% end %>
      </div>

      <div>
        <strong>ID:</strong>
        <%= order.public_id || order.id %>
      </div>

      <div>
        <strong>Cost Notches:</strong>
        <%= order.notch_cost %>
      </div>
      <% if order.address_id.present? %>
        <div>
          <strong>Address:</strong>
          <% address = HackclubAuthService.new(current_user).get_address_from_id(order.address_id) %>
          <%= [address[:line_1], address[:city], address[:state]].select(&:present?).join(", ") %>
        </div>
      <% end %>  
    </div>
    <div class="order-status">
      <div>
        <strong>Status:</strong>
        <% if order.status == "denied" %>
          <span style="color: red;">Denied</span>
        <% elsif order.status == "pending" %>
          <span style="color: orange;">Pending</span>
        <% elsif order.status == "awaiting_periodic_fulfillment" %>
          <span style="color: orange;">Awaiting Periodic Fulfillment</span>
        <% elsif order.status == "shipped" %>
          <span style="color: green;">Fulfilled</span>
        <% elsif order.status == "user_denied" %>
          <span style="color: red;">User Denied</span>
        <% elsif order.status == "submitted" %>
          <span style="color: green;">Submitted</span>
        <% elsif order.status == "cancelled" %>
          <span style="color: red;">Cancelled</span>
        <% else %>
          <span>Unknown - <%= order.status %></span>
        <% end %>
      </div>

      <div>
        <strong>Created At:</strong>
        <%= order.created_at.strftime("%B %d, %Y %I:%M %p") %>
      </div>

      <% if order.status == "pending" && current_page?(order_path(order)) && ((order.user == current_user && order.can_cancel) || current_user.admin?) %>
        <div>
          <% id_value = order_public_id_by_id(order.id) || order.id %>
          <%= button_to "Cancel Order", order_path(id_value, status: "user_denied"), method: :put, class: 'btn-retro btn-retro--outline', data: { confirm: "Are you sure you want to cancel this order?" } %>
        </div>
      <% end %>
      
      <div class="order-actions">
        <% unless current_page?(order_path(order)) %>
          <%= link_to "Show this order", order, class: 'btn-retro btn-retro--outline' %>
        <% end %>
      </div>
    </div>
  </div>
</div>
