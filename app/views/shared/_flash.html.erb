<% if flash.any? %>
  <%# Map Rails flash keys (and custom keys) to our visual tiers %>
  <% mapping = { notice: :pass, success: :pass, pass: :pass, info: :info, warning: :warn, warn: :warn, warn_reject: :warn, alert: :error, error: :error, danger: :error } %>

  <%# Labels --- prefer a label keyed by the original flash key when present %>
  <% labels = { pass: 'Pass', info: 'Info - Not enough credits', warn: 'Warn - Auth issue', error: 'Error - System Error', warning: 'Warning', warn_reject: "This was rejected" } %>

  <div class="retro-container" style="margin-top:12px;">
    <% seen = [] %>
    <% flash.each do |key, msg| %>
      <% next if msg.blank? %>
      <% next if seen.include?(msg.to_s) %>
      <% seen << msg.to_s %>

      <% flash_key = key.to_s.to_sym %>
      <% tier = mapping[flash_key] || flash_key %>
      <% tier = :info unless [:pass, :info, :warn, :error].include?(tier) %>

      <% display_label = labels[flash_key] || labels[tier] || flash_key.to_s.humanize %>

      <div class="callout" data-flash="<%= tier %>"><strong><%= display_label %>:</strong> <%= msg %></div>
    <% end %>
  </div>
<% end %>
