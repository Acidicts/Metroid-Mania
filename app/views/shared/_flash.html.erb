<div id="flash" style="position:fixed; top:50px; padding-top: 25px; left:50%; transform:translateX(-50%); z-index:9999; width:100%; max-width:600px; pointer-events:none;">
  <% if flash.any? %>
    <%# Map Rails flash keys (and custom keys) to our visual tiers %>
    <% mapping = { notice: :pass, success: :pass, pass: :pass, info: :info, warning: :warn, warn: :warn, warn_reject: :warn, alert: :error, error: :error, danger: :error } %>

    <%# Labels --- prefer a label keyed by the original flash key when present %>
    <% labels = { pass: 'Success', info: 'Info', warn: 'Warn', error: 'Error - System Error', warning: 'Warning', warn_reject: "This was rejected" } %>

    <div class="retro-container" style="margin-top:0; pointer-events:auto;">
      <% seen = [] %>
      <% flash.each do |key, msg| %>
        <% next if msg.blank? %>
        <% next if key.to_s == 'delete_product_id' %>
        <% next if seen.include?(msg.to_s) %>
        <% seen << msg.to_s %>

        <% flash_key = key.to_s.to_sym %>
        <% tier = mapping[flash_key] || flash_key %>
        <% tier = :info unless [:pass, :info, :warn, :error].include?(tier) %>

        <% display_label = labels[flash_key] || labels[tier] || flash_key.to_s.humanize %>

        <div class="callout" style=" background-color: #FFF2E3; background-opacity:20%; display:flex; justify-content:space-between; align-items:center;" data-flash="<%= tier %>">
          <span><strong><%= display_label %>:</strong> <%= raw(msg) %>
            <% if flash[:delete_product_id] && tier == :warn %>
              <%= button_to 'Force Delete', product_path(flash[:delete_product_id], force: true), method: :delete, data: { confirm: 'Delete this product?' }, class: 'btn-retro-admin btn-retro-admin--danger pixelify-sans' %>
            <% end %>
          </span>
          <button onclick="this.closest('.callout').remove()" style="background:none; border:none; cursor:pointer; font-size:1.2rem; padding:0 4px; opacity:0.6;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">&times;</button>
        </div>
      <% end %>
    </div>

    <script>
      (function() {
        setTimeout(function() {
          document.querySelectorAll('#flash .callout').forEach(function(el) {
            el.style.transition = 'opacity 0.5s ease-out';
            el.style.opacity = '0';
            setTimeout(function() { el.remove(); }, 500);
          });
        }, 3000);
      })();
    </script>
  <% end %>
</div>
