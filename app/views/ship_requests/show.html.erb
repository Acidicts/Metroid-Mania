<h1>Ship request for <%= @project.name %> (#<%= @ship_request.id %>)</h1>

<% content_for :styles do %>
  <%= stylesheet_link_tag "devlogs", "data-turbo-track": "reload" %>
<% end %>

<%= render partial: 'devlogs/ship_request', locals: { ship_request: @ship_request, project: @project, ship_queue_placement: @ship_queue_placement } %>

<% for dev in @ship_request.devlogs.order(log_date: :desc) %>
  <% if !dev.title.downcase.include?("ship") %>
    <%= render dev %>
  <% end %>
<% end %>

<div class="nb-linkbar" style="margin-top:12px;">
  <%= link_to '← Back to project', project_path(@project), class: 'nb-link' %>
</div>
