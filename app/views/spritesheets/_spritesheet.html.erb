<div class="spritesheet-card" style="background: linear-gradient(180deg, #fff, rgba(255,255,255,0.94)); border: 3px solid var(--main-700); border-radius: 8px; overflow: hidden; box-shadow: 8px 10px 0 var(--main-800);">
  <%= link_to assets_item_spritesheet_path(spritesheet.assets_item, spritesheet), style: "text-decoration: none; color: inherit;" do %>
    <div class="spritesheet-image" style="background: rgba(0,0,0,0.05); padding: 12px; text-align: center;">
      <img src="<%= spritesheet.url %>" alt="<%= spritesheet.name %>" style="max-width: 100%; max-height: 200px; border-radius: 6px; object-fit: cover;">
    </div>
  <% end %>
  
  <div class="spritesheet-content" style="padding: 12px 16px;">
    <h4 style="margin: 0 0 8px 0; font-size: 1rem; color: var(--main-900);">
      <%= link_to spritesheet.name, assets_item_spritesheet_path(spritesheet.assets_item, spritesheet), style: "color: inherit; text-decoration: none;" %>
    </h4>
    
    <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px;">
      <%= link_to "View", assets_item_spritesheet_path(spritesheet.assets_item, spritesheet), target: "_blank", rel: "noopener", class: "btn-retro", style: "font-size: 0.85rem; padding: 6px 10px;" %>
      
      <% if current_user == spritesheet.assets_item.user || admin? %>
        <%= link_to "Edit", edit_assets_item_spritesheet_path(spritesheet.assets_item, spritesheet), class: "btn-retro btn-retro--outline", style: "font-size: 0.85rem; padding: 6px 10px;" %>
        <%= button_to "Delete", [spritesheet.assets_item, spritesheet], method: :delete, class: "btn-retro btn-retro--outline", style: "font-size: 0.85rem; padding: 6px 10px;", 
            form: { data: { turbo_confirm: "Are you sure you want to delete this spritesheet?" } } %>
      <% end %>
    </div>
  </div>
</div>
