<p class="notice"><%= notice %></p>

<% content_for :title, "Charm slots" %>

<% content_for :styles do %>
  <%= stylesheet_link_tag "pages/charm-slots-index", "data-turbo-track": "reload" %>
<% end %>

<%# compute once for readability %>
<% ordered_slots = @charm_slots.where.not(order_id: nil).order(:order_id) %>
<% empty_slots   = @charm_slots.where(order_id: nil) %>
<% submitted_slots = ordered_slots.select(&:submitted?) %>
<% available_slots = ordered_slots.reject(&:submitted?) %>
<% empty_slot = empty_slots.first %>

<div id="charms-container">
  <section id="submitted-charms" class="charm-section">
    <details class="submitted-panel">
      <summary>
        <span class="submitted-summary-title">Submitted Charms (<%= submitted_slots.count %>)</span>
        <span class="submitted-summary-hint" data-collapsed="Show" data-open="Hide"></span>
      </summary>

      <% if submitted_slots.any? %>
        <p class="submitted-summary-copy">These charms are already submitted and read-only in this view.</p>
      <% else %>
        <p class="submitted-summary-copy">No charms submitted yet.</p>
      <% end %>

      <div class="slots">
        <% submitted_slots.each do |slot| %>
          <%= render slot %>
        <% end %>

        <% extras = [0, 5 - submitted_slots.count].max %>
        <% extras.times do %>
          <%= render(empty_slot) if empty_slot %>
        <% end %>
      </div>
    </details>
  </section>

  <section id="available-charms" class="charm-section">
    <h2>Current Loadout</h2>
    <div class="slots">
      <% available_slots.each do |slot| %>
        <%= render slot %>
      <% end %>

      <% extras = [0, 5 - available_slots.count].max %>
      <% extras.times do %>
        <%= render(empty_slot) if empty_slot %>
      <% end %>
    </div>
  </section>
</div>

<div id="charm_notches">
  <p><strong>Notches:</strong></p>
  <div class="notch-icons">
    <% if current_user %>
      <% full_count  = current_user.charm_notches.where.not(charm_slot: nil).count.to_i %>
      <% empty_count = current_user.charm_notches.where(charm_slot: nil).count.to_i %>

      <% full_count.times do %>
        <% if asset_exists?("charm_notch_full.png") %>
          <%= image_tag "charm_notch_full.png", width: 64, height: 64, alt: "Notch Icon", class: "notch-icon" %>
        <% else %>
          <span class="notch-icon missing">missing da image - full</span>
        <% end %>
      <% end %>

      <% empty_count.times do %>
        <% if asset_exists?("charm_notch_empty.png") %>
          <%= image_tag "charm_notch_empty.png", width: 64, height: 64, alt: "Notch Icon", class: "notch-icon" %>
        <% else %>
          <span class="notch-icon missing">missing da image - empty</span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<div id="actions" style="margin-top: 16px; display: inline-flex; gap: 16px;">
  <%= button_to "Browse Charms", products_path, method: :get, class: 'btn-retro', form: { style: "display:inline" } %>
  <% if current_user && CharmSlot.joins(:order).where(user: current_user, orders: { status: "pending" }).exists? %>
    <%= button_to "Submit Loadout", submit_charm_slots_path, method: :post, class: 'btn-retro', form: { style: "display:inline" } %>
    <span style="align-self:center; font-size: 14px;">Submitting Loadout - Causes Slots to be hidden as they are submitted but are visible on use profile</span>
  <% end %>
</div>