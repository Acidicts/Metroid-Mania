<div id="<%= dom_id charm_slot %>" class="charm-slot">

  <% if charm_slot.order_id.present? %>
    <%# Show an image if the related order has either a custom charm URL or a product image %>
    <% if charm_slot.order.charm_image_url_for_display.present? %>
      <% if request.path == charm_slots_path %>
        <div style="position: relative; display: inline-block;">
          <a href="<%= order_path(charm_slot.order) %>" title="<%= charm_slot.order.name.split(" - ").first %>" class="charm-slot-link">
            <img height="96px" width="96px" src="<%= charm_slot.order.charm_image_url_for_display %>" alt="Charm image" />
          </a>
          <% if !charm_slot.submitted? %>
            <%= link_to remove_charm_slot_path(charm_slot), method: :patch, class: "remove-charm-slot-link", title: "Remove Charm" do %>
              <span style="position:relative; top:0">&times;</span>
            <% end %>
          <% else %>
            <span id="checkmark-<%= charm_slot.id %>" style="position:relative; top:0; color: #ffffff; background-color: #25b900; border-radius: 50%; padding: 2px; cursor: pointer;">&checkmark;</span>
            <span id="submitted-indicator-<%= charm_slot.id %>" style="display: none;">Submitted</span>
            <script>
              // Add a green checkmark overlay to indicate submission
              const checkmark = document.getElementById("checkmark-<%= charm_slot.id %>");
              const indicator = document.getElementById("submitted-indicator-<%= charm_slot.id %>");
              
              indicator.style.position = "absolute";
              indicator.style.top = "0";
              indicator.style.left = "0";
              indicator.style.color = "#ffffff";
              indicator.style.backgroundColor = "#25b900";
              indicator.style.borderRadius = "50%";
              indicator.style.padding = "2px";
              
              checkmark.addEventListener("mouseenter", function() {
                indicator.style.display = "inline-block";
              });
              
              checkmark.addEventListener("mouseleave", function() {
                indicator.style.display = "none";
              });
            </script>
          <% end %>
          </div>
      <% else %>
        <a href="<%= order_path(charm_slot.order) %>" title="<%= charm_slot.order.name.split(" - ").first %>" class="charm-slot-link">
          <img height="48px" width="48px" src="<%= charm_slot.order.charm_image_url_for_display %>" alt="Charm image" />
        </a>
      <% end %>
    <% else %>
      <%= charm_slot.order.name %>
    <% end %>
  <% else %>
    <% if request.path != charm_slots_path %>
      <%= charm_slot.order_id %>
      <%= image_tag "charm_notch_empty.png", height: "48px", width: "48px"%>
    <% else %>
      <%= charm_slot.order_id %>
      <%= image_tag "charm_notch_empty.png", height: "48px", width: "48px"%>
    <% end %>
  <% end %>

</div>
