<div id="charm_slots">
  <%# Only show pending slots in the header loadout.  The controller now filters
      @charm_slots to pending orders but we guard again here just in case this
      partial is ever reused elsewhere. %>
  <% if request.path != charm_slots_path %>
    <% pending_slots = @charm_slots.select { |s| s.order&.pending? } %>
    <% empty_slots = 5 - pending_slots.count %>


    <% if CharmSlot.where(order_id: nil).count == 0 %>
      <% empty_slot = CharmSlot.new %>
    <% else %>
      <% empty_slot = CharmSlot.where(order_id: nil).first %>
    <% end %>

    <% empty_slots.times do %>
      <%= render empty_slot %>
    <% end %>
    <% pending_slots.each do |charm_slot| %>
      <%= render partial: 'charm_slots/charm_slot', locals: { charm_slot: charm_slot } %>
    <% end %>
  <% end %>
</div>
