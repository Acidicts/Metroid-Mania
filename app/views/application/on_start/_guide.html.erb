<style>
    :root {
        --timeline-line: var(--main-500);
    }

    .timeline::before { display: none; }
    .timeline-step::before { display: none; }
    .timeline-step::after { display: none; }

    .container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0, 0, 0, 0.6);
        padding: 12px;
        overflow: auto;
        box-sizing: border-box;
        min-height: 100vh;
    }

    .guide {
        background: var(--accent3);
        width: 100%;
        max-width: min(560px, calc(100vw - 32px));
        padding: 20px 20px 0.75rem;
        border-radius: 14px;
        border: 4px solid var(--main-500);
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin: 0 auto;
        max-height: calc(100vh - 32px);
        min-height: 0;
        overflow-y: auto;
        box-sizing: border-box;
        position: relative;
    }

    .guide h1 {
        margin: 0;
        font-size: 1.4rem;
        letter-spacing: -0.03em;
    }

    .guide p {
        margin: 0;
        line-height: 1.7;
        color: var(--main-900);
    }

    .timeline {
        position: relative;
        display: grid;
        gap: 1rem;
        padding: 1rem 0 0.5rem;
    }

    .timeline-step {
        position: relative;
        width: min(42%, 220px);
        padding: 0.7rem 0.9rem;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
        z-index: 1;
        box-sizing: border-box;
    }

    .timeline-step:nth-child(odd) {
        justify-self: start;
    }

    .timeline-step:nth-child(even) {
        justify-self: end;
    }

    .timeline-step h2 {
        margin: 0 0 0.3rem;
        font-size: 0.9rem;
        color: var(--main-900);
    }

    .timeline-step p {
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.4;
        color: var(--main-900);
        opacity: 0.9;
    }

    #page-content-guide {
        opacity: 0;
        transition: opacity 240ms ease-in-out;
        height: 90vh;
        box-sizing: border-box;
    }

    #page-content-guide.visible {
        opacity: 1;
    }

    @media (max-width: 640px) {
        #page-content-guide {
            width: 80vw;
        }
    }

    .guide form {
        display: grid;
        gap: 18px;
        padding: 0;
        border: none;
        background: none;
        border-radius: 0;
    }

    .guide .field {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: rgba(255, 255, 255, 0.08);
        border: 2px solid rgba(255, 255, 255, 0.14);
        border-radius: 12px;
    }

    .guide .field[disabled] {
        opacity: 0.5;
        pointer-events: none;
    }

    .guide label {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: var(--main-900);
    }

    .guide input[type="checkbox"] {
        width: 20px;
        height: 20px;
        accent-color: var(--accent1);
    }

    .guide .form-actions {
        display: flex;
        justify-content: flex-end;
    }

    .guide input[type="submit"] {
        cursor: pointer;
    }

    .guide-summary ul {
        list-style: none;
        margin: 0.5rem 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .guide-summary li {
        padding: 10px 14px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        line-height: 1.5;
        color: var(--main-900);
    }

    .guide-actions {
        display: flex;
        gap: 14px;
        justify-content: space-between;
        flex-direction: row;
        margin-top: auto;
        position: sticky;
        bottom: 0;
        background: var(--accent3);
        padding-top: 12px;
        z-index: 2;
    }

    .guide-actions button,
    .guide-actions a {
        flex: 1;
        min-width: 120px;
        padding: 0.9rem 1rem;
        margin: 0;
        border-radius: 10px;
        border: 2px solid var(--main-500);
        background: var(--accent2);
        color: var(--main-900);
        text-align: center;
        text-decoration: none;
        font-size: inherit;
        font-family: inherit;
        font-weight: inherit;
        transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
    }

    .guide-actions button:hover,
    .guide-actions a:hover {
        transform: translateY(-1px);
        background: var(--accent1);
        border-color: var(--main-700);
    }

    #get-started-button {
        font-size: 1.1rem;
        font-weight: 700;
    }

    @media (max-width: 640px) {
        .guide {
            padding: 20px;
        }

        .guide .field {
            flex-direction: column;
            align-items: stretch;
        }

        .guide .form-actions {
            justify-content: center;
        }
    }
</style>

<div class="container">
    <div class="guide">
        <div id="page-content-guide"></div>

        <%= render partial: "application/on_start/page_1"%>
        <%= render partial: "application/on_start/page_2"%>
        <%= render partial: "application/on_start/page_3"%>
        <%= render partial: "application/on_start/page_4"%>

        <script>
            (() => {
                const pages = [
                    document.getElementById('guide-page-0').innerHTML,
                    document.getElementById('guide-page-1').innerHTML,
                    document.getElementById('guide-page-2').innerHTML,
                    document.getElementById('guide-page-3').innerHTML
                ];
                let currentPage = 0;
                let isTransitioning = false;
                const guide = document.querySelector('.guide');
                const content = document.getElementById('page-content-guide');

                const getButtons = () => ({
                    nextButton: content.querySelector('#guide-next-button'),
                    backButton: content.querySelector('#guide-back-button')
                });

                const updateButton = () => {
                    const { nextButton, backButton } = getButtons();
                    if (!nextButton || !backButton) return;
                    if (currentPage + 1 < pages.length) {
                        nextButton.style.display = '';
                    } else {
                        nextButton.style.display = 'none';
                    }
                    if (currentPage > 0) {
                        backButton.style.display = '';
                    } else {
                        backButton.style.display = 'none';
                    }
                };

                const renderPage = () => {
                    content.innerHTML = pages[currentPage];
                    updateButton();
                    requestAnimationFrame(() => {
                        content.classList.add('visible');
                        if (currentPage === 1) {
                            requestAnimationFrame(drawTimelinePath);
                        }
                    });
                };

                const changePage = (nextPage) => {
                    if (isTransitioning || nextPage === currentPage) return;
                    isTransitioning = true;
                    content.classList.remove('visible');
                    setTimeout(() => {
                        currentPage = Math.min(nextPage, pages.length - 1);
                        renderPage();
                        isTransitioning = false;
                    }, 240);
                };

                guide.addEventListener('click', (e) => {
                    const btn = e.target.closest('button');
                    if (btn && btn.id === 'guide-next-button') {
                        changePage(currentPage + 1);
                    } else if (btn && btn.id === 'guide-back-button') {
                        changePage(currentPage - 1);
                    }
                });

                content.addEventListener('click', (e) => {
                    const submitBtn = e.target.closest('.address-submit-btn');
                    if (!submitBtn) return;
                    e.preventDefault();
                    e.stopPropagation();

                    const form = content.querySelector('#address-form');
                    if (!form) return;

                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Saving...';

                    const formData = new FormData(form);

                    const addressId = form.dataset.addressId;
                    const url = addressId ? '/addresses/' + addressId : '/addresses';
                    const method = addressId ? 'PATCH' : 'POST';

                    fetch(url, {
                        method: method,
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        }
                    })
                    .then(response => response.json().then(data => ({ ok: response.ok, data })))
                    .then(({ ok, data }) => {
                        if (ok) {
                            changePage(currentPage + 1);
                        } else {
                            submitBtn.disabled = false;
                            submitBtn.textContent = 'Save & Continue';
                            if (data.errors) {
                                let errorDiv = form.querySelector('.address-errors');
                                if (!errorDiv) {
                                    errorDiv = document.createElement('div');
                                    errorDiv.className = 'address-errors';
                                    errorDiv.innerHTML = '<ul></ul>';
                                    form.prepend(errorDiv);
                                }
                                const ul = errorDiv.querySelector('ul');
                                ul.innerHTML = data.errors.map(err => '<li>' + err + '</li>').join('');
                            }
                        }
                    })
                    .catch(() => {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Save & Continue';
                    });
                });

                renderPage();
            })();

            function drawTimelinePath() {
                const timeline = document.querySelector('.timeline');
                if (!timeline) return;
                const steps = Array.from(timeline.querySelectorAll('.timeline-step'));
                if (!steps.length) return;

                timeline.querySelectorAll('svg.tl-snake').forEach(s => s.remove());

                const W = timeline.offsetWidth;
                const H = timeline.offsetHeight;
                const REM = parseFloat(getComputedStyle(document.documentElement).fontSize);

                const makeSvg = (zIndex) => {
                    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                    svg.classList.add('tl-snake');
                    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
                    svg.style.cssText = `position:absolute;top:0;left:0;width:100%;height:${H}px;pointer-events:none;z-index:${zIndex};overflow:visible;`;
                    return svg;
                };

                // Path SVG sits behind boxes (z-index 0), dot SVG sits in front (z-index 2)
                const pathSvg = makeSvg(0);
                const dotSvg  = makeSvg(2);

                // Dot anchor: where the path visually "touches" each box
                // Odd steps (0-indexed) are left-aligned → anchor on their RIGHT edge
                // Even steps are right-aligned → anchor on their LEFT edge
                const getDotPos = (step, i) => {
                    const isLeft = i % 2 === 0;
                    const dotY = step.offsetTop + 1.4 * REM + 8;
                    const dotX = isLeft
                        ? step.offsetLeft + step.offsetWidth
                        : step.offsetLeft;
                    return { x: dotX, y: dotY };
                };

                const pts = steps.map(getDotPos);

                const allPts = [...pts];

                // Build a cubic-bezier snake through every point.
                // C prev.x midY, curr.x midY, curr.x curr.y
                // This keeps the path vertical at each anchor and transitions
                // horizontally in the middle — exactly the organic S-curve in the image.
                let d = `M ${allPts[0].x} ${allPts[0].y}`;
                for (let i = 1; i < allPts.length; i++) {
                    const prev = allPts[i - 1];
                    const curr = allPts[i];
                    const midY = (prev.y + curr.y) / 2;
                    d += ` C ${prev.x} ${midY} ${curr.x} ${midY} ${curr.x} ${curr.y}`;
                }

                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', d);
                path.setAttribute('fill', 'none');
                path.setAttribute('stroke', 'var(--timeline-line, rgba(255,255,255,0.6))');
                path.setAttribute('stroke-width', '11');
                path.setAttribute('stroke-dasharray', '6 20');
                path.setAttribute('stroke-linecap', 'round');
                path.setAttribute('stroke-linejoin', 'round');
                pathSvg.appendChild(path);

                // Draw dots in the front SVG so they appear above the boxes
                pts.forEach(pt => {
                    const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                    c.setAttribute('cx', pt.x);
                    c.setAttribute('cy', pt.y);
                    c.setAttribute('r', '7');
                    c.setAttribute('fill', 'var(--accent1)');
                    c.setAttribute('stroke', 'var(--main-500)');
                    c.setAttribute('stroke-width', '2.5');
                    dotSvg.appendChild(c);
                });

                timeline.prepend(dotSvg);
                timeline.prepend(pathSvg);
            }

            window.addEventListener('resize', () => {
                if (document.querySelector('.timeline')) drawTimelinePath();
            });
        </script>
    </div>
</div>