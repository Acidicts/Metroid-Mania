<template id="guide-page-2">
    <h1 id="guide-title">Choose Your Username</h1>
    <p>This is how other users will see you on the leaderboard and in the program.</p>
    <%= form_tag "/profile", method: :patch, id: "username-form", data: { turbo: "false" } do %>
        <div class="guide-username-field">
            <label for="username_input" class="guide-username-label">Username</label>
            <%= text_field_tag "user[username]", current_user.username, id: "username_input", class: "guide-username-input", placeholder: "e.g. metroidfan42", maxlength: 30, autofocus: true %>
            <span id="username-status" class="guide-username-status"></span>
        </div>
    <% end %>
    <div class="guide-actions">
        <button id="guide-back-button" type="button" class="btn-retro">Back</button>
        <button id="guide-next-button" type="submit" form="username-form" class="btn-retro">Next</button>
    </div>
</template>
