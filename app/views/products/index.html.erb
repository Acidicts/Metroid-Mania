<% content_for :styles do %>
  <style>
    /* smooth scrolling for in-page wishlist links */
    html { scroll-behavior: smooth; }
    /* Product grid and cards */
    .products-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
    .product-card { display: flex; gap: 12px; align-items: stretch; border-radius: 8px; padding: 8px; border: 2px dashed rgba(0,0,0,0.6); background: #fff; position: relative; min-height: 210px; }
    .product-image { max-width: 100px; max-height: 150px; object-fit: cover; border-radius: 4px; }
    .product-content { display: flex; flex-direction: column; flex: 1 1 auto; position: relative; padding: 6px 8px; }
    .product-content h3 { margin-top: 0; margin-bottom: 6px; }
    .product-actions { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: auto; }

    body.products .products-placeholder { display: block; }

    .admin-product-form {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 16px;
    }

    .products-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }
  </style>
<% end %>

<style>
  
</style>

<div class="products-header">
  <h1>Merchant</h1>
  <% @user = current_user %>
  <%= form_with model: @user, url: profile_path, method: :patch, local: true, html: { class: "admin-product-form" } do |f| %>
    <div class="form-group">
      <%= f.label :set_region, "Select Your Region" %>
      <%= f.select :set_region, options_for_select(User::REGIONS.map { |r| [r, r] }, @user.set_region.presence || @user.region), { include_blank: "Choose a region" }, class: "form-input", onchange: "this.form.submit()" %>
    </div>
  <% end %>
</div>

<% if current_user %>
  <%= render current_user.wishlist %>
<% end %>

<hr style="color: var(--main-600);">

<h2>The Goods</h2>

<% if current_user&.admin? %>
  <%= link_to "New product (Admin)", new_product_path, class: 'btn-retro btn-retro--small' %>
  <p style="margin-bottom: 10px;"></p>
<% end %>

<div id="products" class="products-grid">
  <% @products.each do |product| %>
    <% if product.show? && (product.regional_prices.where(region: @user.set_region, enabled: true).exists? || product.regional_prices.where(region: "Rest of the World", enabled: true).exists? ) %>
      <%= render 'product_card', product: product %>
    <% elsif current_user&.admin? %>
      <%= render 'product_card', product: product %>
    <% end %>
  <% end %>
</div>
