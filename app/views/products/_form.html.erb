<%= form_with(model: product, html: { multipart: true, class: 'admin-product-form' }) do |form| %>
  <% if product.errors.any? %>
    <div class="error-summary" role="alert">
      <strong><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</strong>
      <ul>
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="main-column">

      <!-- ── Product Info ── -->
      <div class="apf-section">
        <div class="apf-section-title">Product Info</div>

        <div class="form-group">
          <%= form.label :name %>
          <%= form.text_field :name, placeholder: "Short product title", class: "form-input" %>
        </div>

        <div class="form-group">
          <%= form.label :description %>
          <%= form.text_area :description, rows: 5, placeholder: "Describe the product and any important details", class: "form-input" %>
        </div>
      </div>

      <!-- ── Pricing ── -->
      <div class="apf-section">
        <div class="apf-section-title">Pricing</div>

        <!-- Fixed-price fields — hidden when variable grant is on -->
        <div id="fixed_price_container" class="form-row collapsible <%= product.variable_grant? ? '' : 'collapsible--open' %>" aria-hidden="<%= product.variable_grant? %>">
          <div class="form-group">
            <%= form.label :price_currency, "Price (USD)" %>
            <%= form.text_field :price_currency, placeholder: "e.g. 4.99", class: "form-input", inputmode: "decimal" %>
            <div class="field-hint">Decimal value, no $ sign. Used for payments.</div>
          </div>
          <div class="form-group">
            <%= form.label :notch_cost, "Notch Cost" %>
            <%= form.number_field :notch_cost, step: 1, placeholder: "e.g. 5", class: "form-input", inputmode: "decimal" %>
            <div class="field-hint">1 Notch = $10. Ensure there is always $5 in value overhead to account for regional variations. $20 = 3 charms, $15 = 2</div>
          </div>
        </div>

        <!-- Credits-per-$ — shown when variable grant is on -->
        <div id="credits_per_dollar_container" class="form-group collapsible <%= product.variable_grant? ? 'collapsible--open' : '' %>" aria-hidden="<%= !product.variable_grant? %>">
          <%= form.label :credits_per_dollar, "Credits per $" %>
          <%= form.number_field :credits_per_dollar, step: 0.01, class: "form-input", placeholder: "e.g. 10" %>
          <div class="field-hint">Conversion ratio used to calculate credits from a dollar amount.</div>
        </div>
      </div>

      <!-- ── Accessories ── -->
      <div class="apf-section">
        <div class="apf-section-title">Accessories</div>
        <div class="field-hint">Create accessory groups and add accessory names inside each group.</div>

        <% if product.accessory_groups.empty? %>
          <% product.accessory_groups.build.accessories.build %>
        <% else %>
          <% product.accessory_groups.each do |group| %>
            <% group.accessories.build if group.accessories.empty? %>
          <% end %>
        <% end %>

        <div id="accessory-groups-container">
          <%= form.fields_for :accessory_groups do |group_fields| %>
            <div class="accessory-group-card" data-accessory-group-card>
              <%= group_fields.hidden_field :id %>
              <%= group_fields.hidden_field :_destroy, class: "accessory-group-destroy-flag" %>

              <div class="accessory-group-header">
                <div class="form-group" style="flex: 1">
                  <%= group_fields.label :name, "Group name" %>
                  <%= group_fields.text_field :name, class: "form-input", placeholder: "Accessory group name" %>
                </div>
                <div class="form-group" style="flex: 1">
                  <%= group_fields.label :required, "Required" %>
                  <%= group_fields.check_box :required, class: "form-checkbox" %>
                </div>
                <button type="button" class="btn-secondary remove-accessory-group-button">Remove group</button>
              </div>
              <div class="field-hint">Add one or more accessories to this group.</div>

              <div class="accessory-items" data-accessory-items>
                <%= group_fields.fields_for :accessories do |accessory_fields| %>
                  <div class="accessory-row" data-accessory-row>
                    <%= accessory_fields.hidden_field :id %>
                    <%= accessory_fields.hidden_field :_destroy, class: "accessory-destroy-flag" %>

                    <div class="accessory-row-inner">
                      <div class="form-group" style="flex: 1">
                        <%= accessory_fields.label :name, "Accessory name" %>
                        <%= accessory_fields.text_field :name, class: "form-input", placeholder: "Accessory name" %>
                      </div>
                      <div class="form-group" style="flex: 1">
                        <%= accessory_fields.label :cost, "Accessory cost" %>
                        <%= accessory_fields.number_field :cost, class: "form-input", placeholder: "Accessory cost" %>
                      </div>
                      <button type="button" class="btn-secondary remove-accessory-button">Remove accessory</button>
                    </div>
                  </div>
                <% end %>
              </div>

              <button type="button" class="btn-primary add-accessory-button">+ Add accessory</button>

              <template class="accessory-row-template">
                <%= group_fields.fields_for :accessories, Accessory.new, child_index: "new_accessories" do |accessory_fields| %>
                  <div class="accessory-row" data-accessory-row>
                    <%= accessory_fields.hidden_field :id %>
                    <%= accessory_fields.hidden_field :_destroy, class: "accessory-destroy-flag" %>

                    <div class="accessory-row-inner">
                      <div class="form-group" style="flex: 1">
                        <%= accessory_fields.label :name, "Accessory name" %>
                        <%= accessory_fields.text_field :name, class: "form-input", placeholder: "Accessory name" %>
                      </div>
                      <div class="form-group" style="flex: 1">
                        <%= accessory_fields.label :cost, "Accessory cost" %>
                        <%= accessory_fields.number_field :cost, class: "form-input", placeholder: "Accessory cost" %>
                      </div>
                      <button type="button" class="btn-secondary remove-accessory-button">Remove accessory</button>
                    </div>
                  </div>
                <% end %>
              </template>
            </div>
          <% end %>
        </div>

        <button type="button" class="btn-primary" id="add-accessory-group-button">+ Add accessory group</button>

        <template id="accessory-group-template">
          <%= form.fields_for :accessory_groups, AccessoryGroup.new, child_index: "new_accessory_groups" do |group_fields| %>
            <div class="accessory-group-card" data-accessory-group-card>
              <%= group_fields.hidden_field :id %>
              <%= group_fields.hidden_field :_destroy, class: "accessory-group-destroy-flag" %>

              <div class="accessory-group-header">
                <div class="form-group" style="flex: 1">
                  <%= group_fields.label :name, "Group name" %>
                  <%= group_fields.text_field :name, class: "form-input", placeholder: "Accessory group name" %>
                </div>
                <button type="button" class="btn-secondary remove-accessory-group-button">Remove group</button>
              </div>
              <div class="field-hint">Add one or more accessories to this group.</div>

              <div class="accessory-items" data-accessory-items>
                <template class="accessory-row-template">
                  <%= group_fields.fields_for :accessories, Accessory.new, child_index: "new_accessories" do |accessory_fields| %>
                    <div class="accessory-row" data-accessory-row>
                      <%= accessory_fields.hidden_field :id %>
                      <%= accessory_fields.hidden_field :_destroy, class: "accessory-destroy-flag" %>

                      <div class="accessory-row-inner">
                        <div class="form-group" style="flex: 1">
                          <%= accessory_fields.label :name, "Accessory name" %>
                          <%= accessory_fields.text_field :name, class: "form-input", placeholder: "Accessory name" %>
                        </div>
                        <div class="form-group" style="flex: 1">
                          <%= accessory_fields.label :cost, "Accessory cost" %>
                          <%= accessory_fields.number_field :cost, class: "form-input", placeholder: "Accessory cost" %>
                        </div>
                        <button type="button" class="btn-secondary remove-accessory-button">Remove accessory</button>
                      </div>
                    </div>
                  <% end %>
                </template>
              </div>

              <button type="button" class="btn-primary add-accessory-button">+ Add accessory</button>
            </div>
          <% end %>
        </template>
      </div>

      <!-- ── Options ── -->
      <div class="apf-section">
        <div class="apf-section-title">Options</div>

        <!-- limited + stock hidden when variable grant is on -->
        <div class="form-row">
          <div id="limited_container" class="form-group collapsible <%= product.variable_grant? ? '' : 'collapsible--open' %>">
            <label class="checkbox-card">
              <%= form.check_box :limited, {}, "1", "0" %>
              <div>
                <%= form.label :limited, "Limited availability" %>
                <div class="field-hint">When stock runs out, hide from store. Only do for stuff that is auto created by system as fallback.</div>
              </div>
            </label>
          </div>

          <div id="stock_container" class="form-group collapsible <%= product.variable_grant? ? '' : 'collapsible--open' %>">
            <%= form.label :stock, "Stock quantity" %>
            <%= form.number_field :stock, min: 0, class: "form-input", placeholder: "Leave blank for unlimited" %>
            <div class="field-hint">Leave blank for unlimited stock.</div>
          </div>
        </div>

        <div id="limited_container" class="form-group collapsible <%= product.variable_grant? ? '' : 'collapsible--open' %>">
          <label class="checkbox-card">
            <%= form.check_box :show, {}, "1", "0" %>
            <div>
              <%= form.label :show, "Show" %>
              <div class="field-hint">When unchecked, hide from store.</div>
            </div>
          </label>
        </div>

        <div class="form-group">
          <%= form.label :link, "Link (optional)" %>
          <%= form.text_field :link, placeholder: "Optional external URL (https://...)", class: "form-input" %>
        </div>
      </div>

      <!-- ── Variable Grant ── -->
      <div class="apf-section">
        <div class="apf-section-title">Variable Grant</div>

        <label class="checkbox-card form-group">
          <%= form.check_box :variable_grant, { id: "variable_grant_checkbox" }, "1", "0" %>
          <div>
            <%= form.label :variable_grant, "Enable variable grant" %>
            <div class="field-hint">Allow users to choose a dollar amount when ordering. Hides fixed-price fields above.</div>
          </div>
        </label>

        <div id="variable_grant_container" class="variable-grant collapsible <%= product.variable_grant? ? 'collapsible--open' : '' %>" aria-hidden="<%= !product.variable_grant? %>">
          <div class="form-row">
            <div class="form-group">
              <%= form.label :grant_min_dollars, "Minimum grant ($)" %>
              <%= form.number_field :grant_min_dollars, value: (@product.grant_min_dollars || (Product::DEFAULT_MIN_GRANT_CENTS / 100.0)), step: 0.01, min: 0, id: "grant_min_dollars_field", class: "form-input" %>
            </div>
            <div class="form-group">
              <%= form.label :grant_max_dollars, "Maximum grant ($)" %>
              <%= form.number_field :grant_max_dollars, value: (@product.grant_max_dollars || (Product::DEFAULT_MAX_GRANT_CENTS / 100.0)), step: 0.01, min: 0, id: "grant_max_dollars_field", class: "form-input" %>
            </div>
          </div>
        </div>
      </div>

      <div class="apf-section">
        <div class="apf-section-title">Achievement</div>

        <label class="checkbox-card form-group">
          <%= form.check_box :achievement_boolean, { id: "achievement_boolean_checkbox" }, "1", "0" %>
          <div>
            <%= form.label :achievement_boolean, "Require achievement unlock to purchase" %>
            <div class="field-hint">When checked, only users who have unlocked the associated achievement can purchase this product.</div>
          </div>
        </label>

        <% if product.achievement %>
          <div class="current-achievement" aria-live="polite">
            <p class="form-note">Current associated achievement:</p>
            <p><strong><%= product.achievement.title %></strong></p>
          </div>
        <% end %>

        <div class="form-group">
          <%= form.label :achievement_id, "Associated achievement (optional)" %>
          <%= form.collection_select :achievement_id, Achievement.all, :id, :title, { include_blank: true }, { class: "form-input" } %>
        </div>
    </div>

      

    <aside class="sidebar-column">
      <div class="apf-section">
        <div class="apf-section-title">Photo</div>
        <div class="form-group">
          <%= form.label :image_file, "Upload image (optional)" %>
          <%= form.file_field :image_file, class: "form-input file-input" %>
          <% if product.image_url.present? %>
            <div class="current-image" aria-live="polite">
              <p class="form-note">Current image</p>
              <img src="<%= product.image_url %>" alt="Product image" />
            </div>
          <% end %>
        </div>
      </div>
    </aside>
    <div class="form-actions">
        <%= form.submit class: "btn-primary" %>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      var checkbox = document.getElementById('variable_grant_checkbox');
      var container = document.getElementById('variable_grant_container');

      function setState() {
        var checked = checkbox && checkbox.checked;

        // grant options panel
        if (container) {
          container.classList.toggle('collapsible--open', !!checked);
          container.setAttribute('aria-hidden', (!checked).toString());
        }

        // fixed-price rows
        var fixedPrice = document.getElementById('fixed_price_container');
        if (fixedPrice) {
          fixedPrice.classList.toggle('collapsible--open', !checked);
          fixedPrice.setAttribute('aria-hidden', (!!checked).toString());
        }

        // credits-per-$ field
        var ratioContainer = document.getElementById('credits_per_dollar_container');
        if (ratioContainer) {
          ratioContainer.classList.toggle('collapsible--open', !!checked);
          ratioContainer.setAttribute('aria-hidden', (!checked).toString());
        }

        // limited + stock fields
        ['limited_container', 'stock_container'].forEach(function(id) {
          var el = document.getElementById(id);
          if (el) {
            el.classList.toggle('collapsible--open', !checked);
            el.setAttribute('aria-hidden', (!!checked).toString());
          }
        });
      }

      if (checkbox) {
        checkbox.addEventListener('change', setState);
        setState();
      }

      // Price <-> Credits sync
      var priceInput = document.getElementById('product_price_currency');
      var costInput  = document.getElementById('product_cost_credits');
      var ratioInput = document.getElementById('product_credits_per_dollar');

      function toNumber(v){ return Number(String(v || '').replace(/[^0-9.\-]/g, '')) || 0; }

      function syncPriceToCost(){
        if (!priceInput || !ratioInput || !costInput) return;
        var ratio = toNumber(ratioInput.value);
        if (ratio > 0) costInput.value = (toNumber(priceInput.value) * ratio).toFixed(2);
      }
      function syncCostToPrice(){
        if (!priceInput || !ratioInput || !costInput) return;
        var ratio = toNumber(ratioInput.value);
        if (ratio > 0) priceInput.value = (toNumber(costInput.value) / ratio).toFixed(2);
      }

      if (priceInput && ratioInput) {
        priceInput.addEventListener('input', syncPriceToCost);
        priceInput.addEventListener('change', syncPriceToCost);
        ratioInput.addEventListener('input', syncPriceToCost);
        ratioInput.addEventListener('change', syncPriceToCost);
      }
      if (costInput && ratioInput) {
        costInput.addEventListener('input', syncCostToPrice);
        costInput.addEventListener('change', syncCostToPrice);
      }

      // Rails strong params permits nested attribute hashes with numeric keys.
      // Use strictly numeric dynamic indexes so all added rows are preserved.
      var nestedIndexSeed = Date.now();
      var nestedIndexCounter = 0;

      function uniqueId() {
        nestedIndexCounter += 1;
        return String(nestedIndexSeed + nestedIndexCounter);
      }

      function removeElementWithDestroyFlag(button, selector) {
        var wrapper = button.closest(selector);
        if (!wrapper) return;
        var destroyInput = wrapper.querySelector('.accessory-destroy-flag, .accessory-group-destroy-flag');
        if (destroyInput) {
          destroyInput.value = '1';
        }
        wrapper.style.display = 'none';
      }

      function bindAccessoryRowButtons(groupCard) {
        var addAccessoryButton = groupCard.querySelector('.add-accessory-button');
        if (addAccessoryButton) {
          addAccessoryButton.addEventListener('click', function() {
            addAccessoryRow(groupCard);
          });
        }

        groupCard.querySelectorAll('.remove-accessory-button').forEach(function(button) {
          button.addEventListener('click', function() {
            removeElementWithDestroyFlag(button, '[data-accessory-row]');
          });
        });

        var removeGroupButton = groupCard.querySelector('.remove-accessory-group-button');
        if (removeGroupButton) {
          removeGroupButton.addEventListener('click', function() {
            removeElementWithDestroyFlag(removeGroupButton, '[data-accessory-group-card]');
          });
        }
      }

      function addAccessoryRow(groupCard) {
        var template = groupCard.querySelector('template.accessory-row-template');
        if (!template) return;
        var container = groupCard.querySelector('[data-accessory-items]');
        if (!container) return;

        var newIndex = uniqueId();
        var html = template.innerHTML.replace(/new_accessories/g, newIndex);
        container.insertAdjacentHTML('beforeend', html);
        var addedRow = container.querySelector('[data-accessory-row]:last-child');
        if (addedRow) {
          addedRow.querySelector('.remove-accessory-button')?.addEventListener('click', function() {
            removeElementWithDestroyFlag(this, '[data-accessory-row]');
          });
        }
      }

      function createGroupFromTemplate() {
        var groupTemplate = document.getElementById('accessory-group-template');
        if (!groupTemplate) return null;
        var html = groupTemplate.innerHTML.replace(/new_accessory_groups/g, uniqueId());
        var wrapper = document.createElement('div');
        wrapper.innerHTML = html;
        return wrapper.firstElementChild;
      }

      function initAccessoryGroups() {
        var groupContainer = document.getElementById('accessory-groups-container');
        if (!groupContainer) return;

        groupContainer.querySelectorAll('[data-accessory-group-card]').forEach(function(card) {
          bindAccessoryRowButtons(card);
        });

        var addGroupButton = document.getElementById('add-accessory-group-button');
        if (addGroupButton) {
          addGroupButton.addEventListener('click', function() {
            var newGroup = createGroupFromTemplate();
            if (newGroup) {
              groupContainer.appendChild(newGroup);
              bindAccessoryRowButtons(newGroup);
            }
          });
        }
      }

      initAccessoryGroups();
    });
  </script>
<% end %>
