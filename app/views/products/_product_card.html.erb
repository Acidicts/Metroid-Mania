<div class="product-card">
      <img src="<%= product.image_url %>" width="96px" height="96px" alt="<%= product.name %> image" class="product-image" loading="lazy">
      <div class="product-content">
        <h3><%= product.name %></h3>
        <p style="word-wrap: break-word; overflow-wrap: break-word;"><%= simple_format(product.description) %></p>
        <p style="word-wrap: break-word; overflow-wrap: break-word;">Notches: <span style="font-family: Comfortaa, monospace;"><%= product.notch_cost %></span></p>
        <p style="word-wrap: break-word; overflow-wrap: break-word;">Stock: <% if product.limited? %><%= product.stock %><% else %><em>Unlimited</em><% end %></p>

        <%# When the user clicks the button we create the order immediately instead of
            showing the intermediate checkout page.  For variable-grant products we
            include the minimum dollar amount so the order validates. %>
        <% order_params = { product_id: product.id } %>
        <% if product.variable_grant? %>
          <% order_params[:grant_amount_dollars] = product.grant_min_dollars %>
        <% end %>
        <% if product.is_unlocked(current_user) %>
          <%= button_to "Add To Loadout", orders_path(order_params), method: :post,
                        class: 'btn-retro buy-button', form: { "data-turbo" => false } %>
        <% else %>
          <button class="btn-retro buy-button disabled" disabled>Locked</button>
        <% end %>
        <% if admin? %>
          <div style="margin-top:8px;">
            <%= link_to 'Edit', edit_product_path(product), class: 'btn-retro-admin' %>
            <%= link_to 'Delete', product_path(product), method: :delete, data: { confirm: 'Delete this product?' }, class: 'btn-retro-admin', style: 'margin-left:6px' %>
          </div>
        <% end %>
      </div>
    </div>