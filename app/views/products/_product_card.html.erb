<div class="product-card">
      <img src="<%= product.image_url %>" alt="<%= product.name %> image" class="product-image" loading="lazy">
      <div class="product-content">
        <h3><%= product.name %></h3>
        <p style="word-wrap: break-word; overflow-wrap: break-word;"><%= simple_format(product.description) %></p>
        <p style="word-wrap: break-word; overflow-wrap: break-word;"><%= credit_label %>: <% if product.cost_in_credits.present? %><%= sprintf('%.2f', product.cost_in_credits) %><% else %><em>from price × ratio</em><% end %></p>

        <%= link_to "Buy Now", new_order_path(product_id: product.id), class: 'btn-retro buy-button' %>
        <% if admin? %>
          <div style="margin-top:8px;">
            <%= link_to 'Edit', edit_product_path(product), class: 'btn-retro-admin' %>
            <%= link_to 'Delete', product_path(product), method: :delete, data: { confirm: 'Delete this product?' }, class: 'btn-retro-admin', style: 'margin-left:6px' %>
          </div>
        <% end %>
      </div>
    </div>