
<%= stylesheet_link_tag "products", "data-turbo-track": "reload" %>

<div class="project-form-card">
  <%= form_with(model: address, class: "admin-product-form address-form", id: "address-form", data: { turbo: false, address_id: address.persisted? ? address.id : nil }, html: { onsubmit: "return false" }) do |form| %>
    <% if address.errors.any? %>
      <div class="error-summary" role="alert">
        <strong><%= pluralize(address.errors.count, "error") %> prohibited this address from being saved:</strong>
        <ul>
          <% address.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="apf-section">
      <div class="apf-section-title">Address</div>

      <div class="form-group">
        <%= form.label :address_line_1, "Address Line 1<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
        <%= form.text_field :address_line_1, required: true, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :address_line_2, "Address Line 2" %>
        <%= form.text_field :address_line_2, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :city, "City<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
        <%= form.text_field :city, required: true, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :province, "State / Province<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
        <%= form.text_field :province, required: true, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :postal_code, "Zip / Postal Code<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
        <%= form.text_field :postal_code, required: true, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :country, "Country<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
        <%= form.select :country, Address.countries.keys, { include_blank: "Select a country" }, required: true, class: "form-input" %>
      </div>
    </div>

    <div class="form-actions">
      <button type="button" class="btn-primary address-submit-btn" style="width:80%; margin-left:10%; margin-right:10%"><%= submit_name %></button>
    </div>
  <% end %>
</div>
