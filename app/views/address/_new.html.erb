<style>
  .address-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .address-modal-overlay.active {
    display: flex;
  }

  .address-modal {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    max-width: 500px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 24px;
    position: relative;
  }

  .address-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid rgba(74, 122, 150, 0.15);
  }

  .address-modal-header h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--main-900, #292831);
  }

  .address-modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #666;
    padding: 4px 8px;
    border-radius: 6px;
    transition: background-color 0.2s;
  }

  .address-modal-close:hover {
    background-color: rgba(0, 0, 0, 0.1);
  }

  .address-modal .form-group {
    margin-bottom: 14px;
  }

  .address-modal .form-group:last-child {
    margin-bottom: 0;
  }

  .address-modal label {
    display: block;
    margin-bottom: 5px;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--admin-900, #292831);
  }

  .address-modal .form-input {
    width: 100%;
    padding: 10px 13px;
    border: 1.5px solid rgba(74, 122, 150, 0.28);
    border-radius: 7px;
    font-size: 0.94rem;
    font-family: inherit;
    background: #fff;
    color: var(--admin-900, #292831);
    box-sizing: border-box;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .address-modal .form-input:focus {
    outline: none;
    border-color: var(--palette-3, #4a7a96);
    box-shadow: 0 0 0 3px rgba(74, 122, 150, 0.13);
  }

  .address-modal .form-actions {
    margin-top: 20px;
    text-align: center;
  }

  .address-modal .btn-submit {
    width: 100%;
    padding: 12px 20px;
    background: linear-gradient(180deg, var(--accent1, #ec3750), var(--accent2, #d62040));
    color: var(--main-900, #292831);
    border: 3px solid var(--main-700, #333);
    border-radius: 8px;
    box-shadow: 4px 4px 0 var(--main-800, #222);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 120ms ease-in-out;
  }

  .address-modal .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 var(--main-800, #222);
  }

  .address-modal .btn-submit:active {
    transform: translateY(1px);
    box-shadow: 2px 2px 0 var(--main-800, #222);
  }

  .address-modal-error {
    background: linear-gradient(180deg, #fff4f6, #ffd9df);
    border: 2px solid var(--red, #ec3750);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 16px;
    color: #7a1024;
    font-size: 0.92rem;
  }

  .address-modal-error ul {
    margin: 8px 0 0 0;
    padding-left: 20px;
  }

  .address-trigger-btn {
    background: none;
    border: none;
    color: #888;
    font-family: inherit;
    font-size: 0.94rem;
    cursor: pointer;
    padding: 0;
    margin-top: 8px;
    text-decoration: underline;
  }

  .address-trigger-btn:hover {
    color: var(--accent1, #d08159);
  }
</style>

<div id="address-modal" class="address-modal-overlay">
  <div class="address-modal">
    <div class="address-modal-header">
      <h3>Add New Address</h3>
      <button type="button" class="address-modal-close" onclick="document.getElementById('address-modal').classList.remove('active')">&times;</button>
    </div>

    <div id="address-modal-errors"></div>

    <form id="address-new-form" action="/addresses" method="post">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="address[reload]" value="true">

      <div class="form-group">
        <label for="address_line_1">Address Line 1 <span style="color:red">*</span></label>
        <input type="text" name="address[address_line_1]" id="address_line_1" required class="form-input">
      </div>

      <div class="form-group">
        <label for="address_line_2">Address Line 2</label>
        <input type="text" name="address[address_line_2]" id="address_line_2" class="form-input">
      </div>

      <div class="form-group">
        <label for="address_city">City <span style="color:red">*</span></label>
        <input type="text" name="address[city]" id="address_city" required class="form-input">
      </div>

      <div class="form-group">
        <label for="address_province">State / Province <span style="color:red">*</span></label>
        <input type="text" name="address[province]" id="address_province" required class="form-input">
      </div>

      <div class="form-group">
        <label for="address_postal_code">Zip / Postal Code <span style="color:red">*</span></label>
        <input type="text" name="address[postal_code]" id="address_postal_code" required class="form-input">
      </div>

      <div class="form-group">
        <label for="address_country">Country <span style="color:red">*</span></label>
        <select name="address[country]" id="address_country" required class="form-input">
          <option value="">Select a country</option>
          <% Address.countries.keys.each do |c| %>
            <option value="<%= c %>"><%= c %></option>
          <% end %>
        </select>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-submit">Save Address</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function() {
    var overlay = document.getElementById('address-modal');
    var form = document.getElementById('address-new-form');
    var errorBox = document.getElementById('address-modal-errors');
    var submitBtn = form ? form.querySelector('.btn-submit') : null;
    if (!overlay || !form || !submitBtn) return;

    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) overlay.classList.remove('active');
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('active')) {
        overlay.classList.remove('active');
      }
    });

    submitBtn.addEventListener('click', function() {
      errorBox.innerHTML = '';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving...';

      fetch('/addresses.json', {
        method: 'POST',
        body: new FormData(form),
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        },
        credentials: 'same-origin'
      })
      .then(function(resp) { return resp.json(); })
      .then(function(data) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Save Address';

        if (data.errors) {
          errorBox.innerHTML = '<div class="address-modal-error"><strong>Errors prevented saving:</strong><ul>' +
            data.errors.map(function(m) { return '<li>' + m + '</li>'; }).join('') + '</ul></div>';
          return;
        }

        if (data.success && data.id && data.display) {
          if (data.reload) {
            window.location.reload();
            return;
          }

          var select = document.querySelector('select[name="order[address]"]');
          if (select) {
            var opt = document.createElement('option');
            opt.value = data.id;
            opt.textContent = data.display;
            select.appendChild(opt);
            select.value = data.id;
          }
          form.reset();
          overlay.classList.remove('active');
        }
      })
      .catch(function(err) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Save Address';
        errorBox.innerHTML = '<div class="address-modal-error">Something went wrong. Please try again.</div>';
      });
    });
  })();
</script>
