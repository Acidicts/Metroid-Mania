
<% liked = current_user.liked_projects.include?(project) %>

<% if current_user != project.user %>
  <%= turbo_frame_tag "like_button_#{project.id}" do %>
    <button
      data-controller="like"
      data-like-liked-value="<%= liked %>"
      data-like-like-url-value="<%= like_project_path(project) %>"
      data-like-unlike-url-value="<%= unlike_project_path(project) %>"
      data-like-count-value="<%= project.likers.count %>"
      data-action="click->like#toggle"
      class="btn-retro btn-retro--outline"
    >
      <%= liked ? '❤️' : '♡' %> - <%= project.likers.count %>
    </button>
  <% end %>
<% else %>
  <p class="btn-retro-noanim btn-retro--outline click_blocked"><%= liked ? '❤️' : '♡' %> - <%= project.likers.count %></p>
<% end %>
