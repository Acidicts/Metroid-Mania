<%= form_with(model: project, html: { multipart: true, class: 'admin-product-form', data: { controller: 'project-url-validator' } }) do |form| %>
  <% if project.errors.any? %>
    <div class="error-summary" role="alert">
      <strong><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</strong>
      <ul>
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="main-column">

      <!-- ── Project Info ── -->
      <div class="apf-section">
        <div class="apf-section-title">Project Info</div>

        <div class="form-group">
          <%= form.label :name, "Project Title/Name" %>
          <%= form.text_field :name, class: "form-input" %>
        </div>

        <div class="form-group">
          <%= form.label :description, "Project Description" %>
          <%= form.text_area :description, rows: 5, placeholder: "Short summary of your project", class: "form-input" %>
        </div>
      </div>

      <!-- ── Links ── -->
      <div class="apf-section">
        <div class="apf-section-title">Links</div>

        <div class="form-group">
          <%= form.label :repository_url, "GitHub Repo URL" %>
          <%= form.text_field :repository_url, id: "repo_text_box", class: "form-input", data: { project_url_validator_target: 'repo' } %>
          <div id="repo-url-status" class="input-status" data-project-url-validator-target="repoStatus" aria-live="polite"></div>
        </div>

        <div class="form-group">
          <%= form.label :readme_url, "Readme Address" %>
          <%= form.text_field :readme_url, id: "readme_text_box", class: "form-input", data: { project_url_validator_target: 'readme' } %>
          <div id="readme-url-status" class="input-status" data-project-url-validator-target="readmeStatus" aria-live="polite"></div>
        </div>
      </div>

      <!-- ── Hackatime ── -->
      <div class="apf-section" data-controller="hackatime-selector" data-hackatime-selector-taken-value="<%= (@taken_hackatime_names || []).join(',') %>">
        <div class="apf-section-title">Hackatime</div>

        <% if @hackatime_projects.present? %>
          <div class="form-group">
            <%= form.label :hackatime_ids, "Link Hackatime Projects" %>
            <select id="hackatime-dropdown" class="form-input" data-action="change->hackatime-selector#add">
              <option value="">Select a Hackatime project...</option>
              <% @hackatime_projects.each do |p| %>
                <option value="<%= p['name'] %>" data-seconds="<%= p['seconds'] %>"><%= "#{p['name']} - #{format_duration(p['seconds'])}" %></option>
              <% end %>
            </select>
          </div>
        <% else %>
          <p class="field-hint"><em>No Hackatime Projects. Start <a href="https://hackatime.hackclub.com/">here</a></em></p>
        <% end %>

        <div id="hackatime-selected" class="hackatime-selected">
          <% (project.hackatime_ids || []).each do |h| %>
            <% seconds = (@hackatime_seconds || {})[h] || (@hackatime_projects || []).find { |p| p['name'] == h }&.dig('seconds') %>
            <div class="hackatime-chip" data-hackatime-value="<%= h %>">
              <span class="hackatime-label"><%= h %></span>
              <% if seconds.present? && seconds.to_i > 0 %>
                <span class="hackatime-seconds"><%= format_duration(seconds.to_i) %></span>
              <% end %>
              <% locked = project.persisted? && project.hackatime_id_locked?(h) %>
              <% if locked %>
                <button type="button" class="hackatime-remove hackatime-remove--locked" disabled title="Cannot remove — this was linked when the project was shipped">✕</button>
              <% else %>
                <button type="button" class="hackatime-remove" data-action="click->hackatime-selector#remove">✕</button>
              <% end %>
              <input type="hidden" name="project[hackatime_ids][]" value="<%= h %>">
            </div>
          <% end %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit "Submit Project", class: "btn-primary" %>
        <% if project.persisted? %>
          <p class="field-hint" style="margin-top: 8px;"><strong>Editing existing project.</strong></p>
        <% end %>
      </div>

    </div>

    <aside class="sidebar-column">

      <!-- ── Image ── -->
      <div class="apf-section">
        <div class="apf-section-title">Image</div>
        <div class="form-group">
          <%= form.label :image, "Project image (optional)" %>
          <div class="file-input-wrapper" data-controller="file-input">
            <%= form.file_field :image, accept: "image/*", class: "visually-hidden file-input-input", data: { action: "change->file-input#update", file_input_target: "input" } %>

            <% if project.respond_to?(:image) && project.image.attached? && project.persisted? %>
              <%= image_tag(project.image, class: 'file-input-preview', data: { file_input_target: 'preview' }, alt: 'Selected image preview', loading: 'lazy', style: 'max-height:160px; max-width:100%; height:auto; border-radius:6px;') %>
            <% else %>
              <img class="file-input-preview visually-hidden" data-file-input-target="preview" alt="Selected image preview">
            <% end %>

            <div style="display:flex; gap:8px; flex-direction:column;">
              <label class="file-input-button" for="<%= form.object_name %>_image">Choose file</label>
              <span class="file-input-filename" style="padding:3px; border: 3px dashed rgba(0,0,0,0.2); border-radius:6px;" data-file-input-target="filename"><%= project.respond_to?(:image) && project.image.attached? ? project.image.filename.to_s : 'No file selected' %></span>
              <button type="button" style="padding:0.375rem; font-weight:800; color:white; border:none; border-radius:6px; background-color:#ec3750;" class="file-input-clear <%= project.respond_to?(:image) && project.image.attached? ? '' : 'visually-hidden' %>" data-action="click->file-input#clear" data-file-input-target="clear">Remove</button>
            </div>
          </div>
        </div>
      </div>

    </aside>
  </div>
<% end %>
