
<% content_for :title, "Projects" %>
<%= stylesheet_link_tag "pages/gallery-index", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "pages/projects-show", "data-turbo-track": "reload" %>


<div id="projects">
  <h1>Projects</h1>
  <%= link_to "New project", new_project_path, class: "btn btn-primary", style: "margin-top: 20px; display: inline-block;" %>
  <div class="project-grid">
    <% @projects.each do |project| %>
      <% if project.name != "Deleted Project" %>
        <%= render project, project: @project %>
      <% end %>
    <% end %>
  </div>
  <% if @enabled %>
    <h2>Assets Projects</h2>
    <div class="project-grid">
      <% @assets.each do |asset| %>
        <% if asset.title != "Deleted Project" %>
          <%= render asset, project: asset %>
        <% end %>
      <% end %>
    </div>
    <%= link_to "New assets project", new_assets_project_path, style: "margin-top: 20px; display: inline-block;" %>
  <% end %>
  <br>
</div>


