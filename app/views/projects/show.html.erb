<% content_for :title, @project.name %>
<% content_for :og_title, @project.name %>
<%# Provide a usable description for social previews.  If the project has no
    description we emit a generic placeholder so crawlers don't skip the tag.
    `truncate` is used to limit length for OG specs.
%>
<% content_for :og_description, (
     @project.description.presence ||
     "No description provided yet – check the project page for details."
   ).to_s.truncate(200) %>
<%# Open Graph image must be a URL string; prefer the request-aware banner URL helper,
    which generates an absolute blob URL when the asset is attached. %>
<% displayed_url = project_banner_url(@project) %>
<% content_for :og_image, displayed_url %>
<% content_for :twitter_card, "summary_large_image" %>
<% content_for :og_author, @project.user&.display_name %>

<% content_for :styles do %>
  <%= stylesheet_link_tag "devlogs", "data-turbo-track": "reload" %>
<% end %>

<div class="retro-container">
  <button onclick="window.location.href='<%= projects_path %>'" class="btn-retro">Back to Projects</button>

  <section class="project-hero" style="margin-top:18px;">
    <div class="hero-left">
      <div class="project-media">
        <%# Use helper so that blob URLs are generated in the context of the
            current HTTP request.  `Project#image_url` is still useful for
            places without a request (migrations, jobs etc) but the view
            needs something request-aware for external crawlers. %>
        <% displayed_url = project_banner_url(@project) %>
        <img class="project-media__img" src="<%= displayed_url %>" alt="<%= @project.name %>">
      </div>    

      <div style="margin-top:12px">
        <h1 class="project-title" style="display: inline-block"><%= @project.name %> <span style="all:unset; color:var(--accent2); font-size:0.8em; background-color:var(--main-900); padding:2px 6px; border-radius:4px; text-shadow:none;"><%= @project.project_tag&.tag %></span></h1>
        <div class="kv" style="margin-bottom:8px">
          <div class="label">By</div>
          <div class="value"><%= link_to @project.user.display_name, user_profile_path(@project.user) %></div>
        </div>
        <p class="project-desc"><%= simple_format(@project.description || 'No description provided yet. \n Required for Ship') %></p>

        <div style="margin-top:12px" class="tech-list">
          <% if @project.hackatime_ids.present? %>
            <% @project.hackatime_ids.each do |t| %>
              <span class="tech"><%= t %></span>
            <% end %>
          <% end %>
        </div>

        <div class="cta-row">
          <%= link_to 'View Repo', safe_url(@project.repository_url), class: 'btn-retro', target: '_blank', rel: 'noopener' %>
          <% if @project.readme_url.present? %>
            <button id="README_BTN" class="btn-retro btn-retro--outline">READ ME</button>
          <% end %>
          <% if logged_in? %>
            <% if current_user.not_liked_project(@project.id) %>
              <%= button_to '♡ - ' + @project.likers.count.to_s,
                            like_project_path(@project),
                            method: :post,
                            class: 'btn-retro btn-retro--outline'
              %>
            <% else %>
              <%= button_to '❤️ - ' + @project.likers.count.to_s,
                              unlike_project_path(@project),
                              method: :post,
                              class: 'btn-retro btn-retro--outline'
                %>
            <% end %>
          <% else %>
            <button class="btn-retro btn-retro--outline" disabled title="Sign in to like projects">
              ♡ - <%= @project.likers.count %>
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <style>
      .README-MENU {
        position: fixed;
        margin-top: 24px;
        padding: 16px;
        background-color: var(--accent3);
        border-radius: 8px;
        top: 10%;
        width: 70%;
        left: 15%;
        border: 4px dashed var(--accent2);
        z-index: 10;
        transition: opacity 0.3s ease;
      }

      .CLOSE_CROSS {
        position: absolute;
        top: 8px;
        right: 12px;
        background: none;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        color: var(--accent2);
        transition: transform 0.2s ease, color 0.2s ease;
      }

      .CLOSE_CROSS:hover {
        color: white;
        transform: rotate(180deg) scale(1.2);
      }

      /* ensure action controls align with the Edit link */
      .featured-actions { align-items: center; }
      .featured-actions form { margin: 0; display: inline-block; }
      .featured-actions > * { align-self: center; }

    </style>

    <div class="README-MENU" id="README_MENU" style="opacity: 0;">
      <button class="CLOSE_CROSS" id="README_CLOSE">x</button>
      <%= github_markdown_to_html(@project.readme_url) %>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const readmeButton = document.getElementById('README_BTN');
        const readmeClose = document.getElementById('README_CLOSE');
        const readmeMenu = document.getElementById('README_MENU');

        function setReadmeVisible(visible) {
          if (!readmeMenu) return;
          readmeMenu.style.opacity = visible ? '1' : '0';
          readmeMenu.style.pointerEvents = visible ? 'auto' : 'none';
          readmeMenu.setAttribute('aria-hidden', visible ? 'false' : 'true');
        }

        if (readmeButton && readmeMenu) {
          readmeButton.addEventListener('click', function() {
            const isVisible = readmeMenu.style.opacity === '1';
            setReadmeVisible(!isVisible);
          });
        }

        if (readmeClose && readmeMenu) {
          readmeClose.addEventListener('click', function() {
            setReadmeVisible(false);
          });
        }

        // close on Escape
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') setReadmeVisible(false);
        });

        // close when clicking outside the menu
        document.addEventListener('click', function(e) {
          if (!readmeMenu || readmeMenu.style.opacity !== '1') return;
          if (!readmeMenu.contains(e.target) && e.target !== readmeButton) {
            setReadmeVisible(false);
          }
        });

        // ensure initial hidden state
        setReadmeVisible(false);
      });
    </script>

    <aside class="hero-right">
      <div class="featured-project" style="box-shadow: 0px 0px 0 rgb(0,0,0,0);">

        <div style="margin-top:10px; top:10px; position:relative;">
          <p><strong>Owner:</strong> <%= link_to @project.user.display_name, user_profile_path(@project.user) %></p>
          <p><strong>Total time:</strong> <%= format_duration(@project.total_seconds) %></p>
          <p><strong>Devlogged:</strong> <%= format_duration(@project.total_devlogged_seconds) %></p>
          <p><strong>Undocumented:</strong> <%= format_duration([@project.total_seconds.to_i - @project.total_devlogged_seconds, 0].max) %></p>
        </div>

        <div class="featured-actions" style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
          <span title="Time Carried Over <%= format_duration(@project.notch_remainder_seconds) %>">
            <%= ship_request_action_buttons(@project) %>
          </span>

          <%= link_to 'Edit', edit_project_path(@project), class: 'btn-retro' %>
        </div>
      </div>
    </aside>
  </section>

  <hr style="margin-top: 64px; margin:24px 0">

  <div class="devlogs-section">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2>Devlogs</h2>
      <% if (@project.total_seconds.to_i - @project.total_devlogged_seconds) > 900 %>
        <%= link_to "New Devlog", new_project_devlog_path(@project), class: "nb-btn nb-btn-secondary" %>
      <% else %>
        <button class="nb-btn-disabled nb-btn-secondary-disabled" style="cursor: not-allowed;" disabled>New Devlog</button>
      <% end %>
    </div>

    <% # Build timeline like the devlogs index: show ship markers and user devlogs (grouped) %>
    <% devlogs = @project.devlogs.where.not(user_id: nil).order(log_date: :desc, created_at: :desc).to_a %>
    <% markers = [] %>
    <% @project.ships.order(shipped_at: :desc).each do |s| %>
      <% markers << { type: 'ship', time: s.shipped_at || s.created_at, obj: s } %>
    <% end %>
    <% markers.sort_by! { |m| m[:time] || Time.at(0) }.reverse! %>

    <% if devlogs.any? || markers.any? %>
      <%# Merge loop %>
      <div id="devlogs" class="timeline">
      <% while devlogs.any? || markers.any? %>
        <% next_devlog = devlogs.first %>
        <% next_marker = markers.first %>

        <%# Compare full timestamps (created_at) for accurate ordering %>
        <% next_devlog_time = next_devlog ? next_devlog.created_at : nil %>
        <% next_marker_time = next_marker ? next_marker[:time] : nil %>

        <% if next_marker && (next_devlog.nil? || (next_marker_time && next_devlog_time && next_marker_time > next_devlog_time) || (next_marker_time && next_devlog_time.nil?)) %>
          <% m = markers.shift %>
          <%= render partial: 'devlogs/ship', locals: { ship: m[:obj] } %>
        <% else %>
          <% d = devlogs.shift %>
          <%= render d %>
        <% end %>
      <% end %>
      </div>
    <% else %>
      <p>No devlogs yet. Document your progress!</p>
    <% end %>
  </div>

</div>
