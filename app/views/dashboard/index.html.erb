<% content_for :title, "Metroidmania" %>
<% content_for :og_title, "Metroidmania" %>
<% content_for :og_description, "Make Metroidvania Games, Get Prizes" %>
<% if (banner_url = asset_url_safe('og_banner.png')) %>
  <% content_for :og_image, banner_url %>
<% else %>
  <% content_for :og_image, "https://placehold.co/1200x630" %>
<% end %>
<% content_for :twitter_card, "summary_large_image" %>
<% content_for :og_author, "Alex & Lenny" %>

<% content_for :styles do %>
  <%= stylesheet_link_tag "pages/dashboard-index", "data-turbo-track": "reload" %>
<% end %>

<div class="home-hero">
  <h1>Metroid-Mania</h1>

  <% if logged_in? %>
    <p class="lead">Hi, <%= current_user.name %>! You have <span style="font-family: Comfortaa, monospace;"><%= current_user.free_notches %> free charm notches</span></p>
    <% if current_user.free_notches == 0 %>
      <p class="lead">You have no free charm notches. Get Coding to earn some!</p>
    <% end %>

    <div class="home-actions">
      <%= link_to "My Projects", projects_path, class: 'btn-retro' %>
      <% if feature_enabled?(:shop) %>
        <%= link_to "Merchant", products_path, class: 'btn-retro' %>
      <% end %>
      <%= link_to "Leaderboard", leaderboards_path, class: 'btn-retro' %>
      <%= link_to "My Charms", charm_slots_loadout_path, class: 'btn-retro' %>
      <%= link_to "My Achievements", achievements_path, class: 'btn-retro' %>
      <% if admin? %>
        <%= link_to "Admin Dashboard", admin_dashboard_path, class: 'btn-retro' %>
      <% end %>
    </div>
    <div class="home-actions">
      <% unless SiteSetting.enabled?('disable_community_goals', default: false) %>
        <%= link_to "Community Goals", goals_path, class: 'btn-retro' %>
      <% end %>
    </div>

    <div class="features" role="region" aria-label="Key features">
      <div class="feature">
        <h2 class="feature-heading">Build Games</h2>
        <p>Create game projects, track and link Hackatime projects.</p>
        <%= link_to "Start Building", new_project_path, class: 'btn-discreet' %>
      </div>
      <div class="feature">
        <h2 class="feature-heading">Equip Charms</h2>
        <p>Visit the merchant to equip charms to get prizes.</p>
        <% if feature_enabled?(:shop) %>
          <%= link_to "Get Redeeming", products_path, class: 'btn-discreet' %>
        <% end %>
      </div>
      <div class="feature">
        <h2 class="feature-heading">Boost Your Rewards</h2>
        <p>Let an admin give you a feature to implement for bonus charm slot.</p>
        <% if feature_enabled?(:shop) %>
          <%= link_to "Get Redeeming", products_path, class: 'btn-discreet' %>
        <% end %>
      </div>
    </div>

  <% else %>
    <p class="lead">Welcome to Metroid-Mania, the Hack Club YSWS where you build Metroidvania games!</p>

    <div class="home-actions">
      <button onclick="window.location.href='<%= hackclub_login_url %>'" data-turbo="false" style="font-family: 'Phantom Sans';font-size:2rem; color:black; background:#ec3750; border:2px solid var(--main-800); cursor:pointer;" class="btn-retro pixelify-sans">Login with Hack Club</button>
    </div>

    <% if params[:demo] == "true" %>
      <%= button_to "Demo", guest_login_path, class: "btn-retro pixelify-sans", method: :get %>
    <% end %>

    <div class="features" role="region" aria-label="Why join">
      <div class="feature">
        <h2 class="feature-heading">Create & Share</h2>
        <p>Start a Metroidvania Game in any language, show your progress in devlogs, and share with the Hack Club community.</p>
      </div>
      <div class="feature">
        <h2 class="feature-heading">Learn Together</h2>
        <p>Find collaborators and learn from other builders on the leaderboard.</p>
      </div>
      <div class="feature">
        <h2 class="feature-heading">Participate</h2>
        <p>Earn prizes, get feedback, and ship polished Metroidvania games.</p>
      </div>
    </div>
  <% end %>

  <% if ORG_SLACK_IDS.any? %>
    <h2 id="organizers-heading">Organizers</h2>
    <div id="meet-the-orgs" role="list" aria-labelledby="organizers-heading">
      <div id="orgs-list" role="presentation">
        <% if @orgs.present? %>
          <% @orgs.each do |org| %>
            <div class="org-card" role="listitem" data-slack-id="<%= org[:id] %>">
              <% if org[:image].present? %>
                <%= image_tag org[:image], alt: "#{org[:name]} avatar", width: 48, height: 48 %>
              <% else %>
                <div style="width:48px; height:48px; border-radius:999px; background:#f3f4f6;"></div>
              <% end %>
              <div class="org-info">
                <div class="org-name"><%= org[:display_name].presence || org[:name] %></div>
                <% if org[:pronouns].present? %>
                  <div class="org-pronouns"><%= org[:pronouns] %></div>
                <% end %>
                <% if org[:title].present? %>
                  <div class="org-pronouns"><%= org[:title] %></div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <!-- No orgs configured -->
        <% end %>
      </div>
    </div>
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        const orgCards = document.querySelectorAll(".org-card");
        orgCards.forEach(card => {
          card.addEventListener("click", function() {
            const slackId = this.dataset.slackId || this.getAttribute('data-slack-id');
            if (!slackId) return;
            const slackUrl = `https://hackclub.slack.com/team/${slackId}`;
            window.open(slackUrl, "_blank");
          });
        });
      });
    </script>
  <% end %>
</div>
