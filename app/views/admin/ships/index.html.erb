<div class="admin-panel">
  <h1>Ships</h1>
  <table class="admin-table">
  <thead>
    <tr>
      <th>Ship ID</th>
      <th>Project</th>
      <th>Owner</th>
      <th>Shipped At</th>
      <th>Devlogged</th>
      <th>Notches Awarded</th>
      <th>Processed By</th>
    </tr>
  </thead>
  <tbody>
    <% @ships.each do |s| %>
      <tr>
        <td><%= link_to s.id, admin_ship_path(s) %></td>
        <td><%= s.project ? link_to(s.project.name, admin_project_path(s.project)) : "Project ##{s.project_id || 'unknown'}" %></td>
        <td><%= s.project&.user&.name || s.project&.user&.email || '-' %></td>
        <td><%= s.shipped_at&.strftime("%b %-d, %Y %l:%M %p") %></td>
        <td><%= format_duration(s.devlogged_seconds.to_i) %></td>
        <td><%= format_credits(s.credits_awarded) %></td>
        <td><%= s.user&.name %></td>
        <td>
          <%= link_to 'View', admin_ship_path(s), class: 'btn-admin btn-admin--muted' %>
          <%= link_to 'Edit', edit_admin_ship_path(s), class: 'btn-admin', style: 'margin-left:8px' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>