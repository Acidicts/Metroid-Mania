<div class="admin-panel">
  <h1>Ship #<%= @ship.id %> for <%= @ship.project&.name || 'Project removed' %></h1>

  <p><strong>Shipped at:</strong> <%= @ship.shipped_at&.strftime("%b %-d, %Y %l:%M %p") %></p>
  <p><strong>Devlogged seconds:</strong> <%= @ship.devlogged_seconds %> (<%= format_duration(@ship.devlogged_seconds.to_i) %>)</p>
  <p><strong>Credits awarded:</strong> <%= @ship.credits_awarded %></p>
  <p><strong>Multiplier:</strong> <%= @ship.multiplier.present? ? @ship.multiplier : '-' %></p>
  <p><strong>Processed by:</strong> <%= @ship.user&.name || @ship.user&.email %></p>

  <p style="margin-top:8px">
    <%= link_to 'Edit Ship', edit_admin_ship_path(@ship), class: 'btn-admin' %>
    <%= link_to '← Back to Ships', admin_ships_path, class: 'btn-admin btn-admin--muted', style: 'margin-left:8px' %>
  </p>

  <h3 style="margin-top:24px">Related audit entries</h3>
  <% if @ship.project %>
    <% @ship.project.audits.order(created_at: :desc).each do |a| %>
      <div style="border:1px solid #ddd; padding:8px; margin-bottom:6px;">
        <strong><%= a.action %></strong> — <%= a.details %> <small><%= a.created_at %></small>
      </div>
    <% end %>
  <% else %>
    <p><em>Related project removed; no audits available.</em></p>
  <% end %>
</div>