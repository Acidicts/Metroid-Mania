<div class="admin-panel">
  <h1>Edit Ship #<%= @ship.id %> for <%= @ship.project&.name || 'Project removed' %></h1>

  <div style="margin-bottom:16px;">
    <p><strong>Project:</strong>
      <% if @ship.project %>
        <%= link_to @ship.project.name, admin_project_path(@ship.project) %>
      <% else %>
        <em>Project removed</em>
      <% end %>
    </p>
    <p><strong>Shipped at:</strong> <%= @ship.shipped_at&.strftime("%b %-d, %Y %l:%M %p") %></p>
    <p><strong>Devlogged:</strong> <%= format_duration(@ship.devlogged_seconds.to_i) %></p>
    <p><strong>Current Multiplier:</strong> <%= @ship.multiplier.present? ? @ship.multiplier : '-' %></p>
  </div>

  <%= render 'form', ship: @ship %>

  <p style="margin-top:12px;">
    <%= link_to '← Back to Ship', admin_ship_path(@ship), class: 'btn-admin btn-admin--muted' %>
  </p>
</div>