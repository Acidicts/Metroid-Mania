<div class="admin-page">
  <h1>Site settings</h1>

  <%= form_with url: admin_site_settings_path, method: :patch, local: true do %>
    <div style="margin-bottom:12px;">
      <label for="site_setting_shop" style="font-weight:600; margin-right:8px;">Store (shop)</label>
      <%= check_box_tag 'site_setting[shop]', '1', SiteSetting.enabled?('shop'), id: 'site_setting_shop' %>
      <span style="color:#6b7280; margin-left:8px;">Enable or disable the public storefront</span>
    </div>

    <div style="margin-bottom:12px;">
      <label for="site_setting_running" style="font-weight:600; margin-right:8px;">YSWS running</label>
      <%= check_box_tag 'site_setting[running]', '1', SiteSetting.enabled?('running'), id: 'site_setting_running' %>
      <span style="color:#6b7280; margin-left:8px;">If unchecked a site-wide banner will tell visitors the event is not active.</span>
    </div>

    <div style="margin-bottom:12px;">
      <label for="site_setting_disable_non_admin_logins" style="font-weight:600; margin-right:8px;">Prevent non‑admin logins</label>
      <%= check_box_tag 'site_setting[disable_non_admin_logins]', '1', SiteSetting.enabled?('disable_non_admin_logins', default: false), id: 'site_setting_disable_non_admin_logins' %>
      <span style="color:#6b7280; margin-left:8px;">When enabled only administrators can sign in.</span>
    </div>

    <div style="margin-bottom:12px;">
      <label for="site_setting_disable_asset_project" style="font-weight:600; margin-right:8px;">Disable Asset Project</label>
      <%= check_box_tag 'site_setting[disable_asset_project]', '1', SiteSetting.enabled?('disable_asset_project', default: false), id: 'site_setting_disable_asset_project' %>
      <span style="color:#6b7280; margin-left:8px;">When enabled the asset project functionality will be turned off.</span>
    </div>

    <h2>Weekly devlog goal</h2>
    <div style="margin-bottom:12px;">
      <label for="site_setting_weekly_goal_threshold_seconds" style="font-weight:600; margin-right:8px;">Threshold (seconds)</label>
      <%= text_field_tag 'site_setting[weekly_goal_threshold_seconds]', SiteSetting.get('weekly_goal_threshold_seconds') || WeeklyGoalService::THRESHOLD_SECONDS, id: 'site_setting_weekly_goal_threshold_seconds', size: 8 %>
      <span style="color:#6b7280; margin-left:8px;">Total seconds required to hit the weekly goal (default 360000 = 100h). When reached, a random contributor receives a free \"prize\" order.</span>
    </div>

    <h2>Community goals</h2>
    <div style="margin-bottom:12px;">
      <label for="site_setting_disable_community_goals" style="font-weight:600; margin-right:8px;">Disable Community Goals</label>
      <%= check_box_tag 'site_setting[disable_community_goals]', '1', SiteSetting.enabled?('disable_community_goals', default: false), id: 'site_setting_disable_community_goals' %>
      <span style="color:#6b7280; margin-left:8px;">When enabled community goals functionality will be turned off.</span>
    </div>

    <%= submit_tag 'Save', class: 'btn-retro' %>
  <% end %>
</div>
