<div class="admin-panel admin-ship-request-page">
  <% project_name = @ship_request.project&.name || "Project ##{@ship_request.project_id || 'unknown'}" %>
  <% requester_name = @ship_request.user&.name || @ship_request.user&.email || "Unknown user" %>

  <div class="admin-page-header admin-ship-request-header">
    <div>
      <p class="admin-ship-request-kicker">Review Ship Request</p>
      <h1><%= project_name %></h1>
      <p class="admin-ship-request-meta">
        Request #<%= @ship_request.id %>
        <% if @ship_request.project.present? %>
          - <%= link_to "Open project", project_path(@ship_request.project), class: "admin-ship-request-project-link" %>
          - <%= link_to "Open Demo", regulate_url(@ship_request.project.demo_link), class: "admin-ship-request-project-link" %>
        <% else %>
          - Project is no longer available
        <% end %>
      </p>
    </div>

    <div class="admin-ship-request-status-panel">
      <span class="admin-ship-request-status-label">Current status</span>
      <%= ship_request_status_badge(@ship_request) %>
    </div>
  </div>


  <div class="admin-ship-request-grid">
    <section class="admin-card admin-ship-request-card">
      <h2>Request details</h2>
      <dl class="admin-ship-request-list">
        <div class="admin-ship-request-list-row">
          <dt>Requested at</dt>
          <dd><%= l(@ship_request.requested_at, format: :short) %></dd>
        </div>
        <div class="admin-ship-request-list-row">
          <dt>Requester</dt>
          <dd><%= requester_name %></dd>
        </div>
        <div class="admin-ship-request-list-row">
          <dt>Devlogged time</dt>
          <dd><%= format_duration(@ship_request.devlogged_seconds.to_i) %></dd>
        </div>
        <div class="admin-ship-request-list-row">
          <dt>Project id</dt>
          <dd><%= @ship_request.project_id || "unknown" %></dd>
        </div>
      </dl>
    </section>

    <section class="admin-card admin-ship-request-card">
      <h2>Credits snapshot</h2>
      <dl class="admin-ship-request-list">
        <div class="admin-ship-request-list-row">
          <dt>Multiplier</dt>
          <dd><%= @ship_request.multiplier.to_f %></dd>
        </div>
        <div class="admin-ship-request-list-row">
          <dt>Credits awarded</dt>
          <dd>
            <% if @ship_request.effective_credits_awarded.present? %>
              <%= correct_credits(@ship_request.effective_credits_awarded) %>
              <% if (s = @ship_request.associated_ship).present? %>
                <span class="admin-ship-request-note">From Ship #<%= s.id %> at <%= l(s.shipped_at, format: :short) %></span>
              <% end %>
            <% else %>
              <em>Not awarded yet</em>
            <% end %>
          </dd>
        </div>
      </dl>
    </section>
  </div>

  <% if @ship_request.pending? %>
    <div class="admin-two-col admin-ship-request-actions-layout">
      <div class="admin-two-col-main">
        <section class="admin-card admin-ship-request-card">
          <h2>Approve and ship</h2>
          <p class="admin-hint">Optionally override defaults before shipping this request.</p>

          <%= form_with url: approve_admin_ship_request_path(@ship_request), method: :post, local: true, class: "admin-form admin-ship-request-form" do |f| %>
            <div class="admin-form-row">
              <%= f.label :multiplier, "Multiplier (optional)", class: "admin-form-label" %>
              <div class="admin-form-control">
                <%= f.number_field :multiplier, value: @ship_request.multiplier, step: 0.01, min: 0.0 %>
              </div>
            </div>

            <div class="admin-form-row">
              <%= f.label :multiplier, "Approved Time", class: "admin-form-label" %>
              <div class="admin-form-control">
                <%= f.number_field :approved_seconds, value: @ship_request.devlogged_seconds, step: 1, min: 0, max: @ship_request.devlogged_seconds %>
              </div>
            </div>

            <div class="admin-form-row">
              <%= f.label :recipient_user_id, "Award credits to user (optional)", class: "admin-form-label" %>
              <div class="admin-form-control">
                <%= f.select :recipient_user_id,
                             options_from_collection_for_select(@users, :id, ->(u) { u.name.presence || u.email }, @ship_request.user_id),
                             { include_blank: "(project owner)" },
                             {} %>
                <span class="admin-ship-request-note">If none selected, credits are awarded to the project owner.</span>
              </div>
            </div>

            <div class="form-group mb-3">
              <%= f.label :comment, "Approval Note", class: "admin-form-label" %>
              <div class="admin-form-control">
                <%= f.text_area :comment, rows: 3, class: "form-control", placeholder: "Enter comment / feedback...", required: false %>
              </div>
            </div>

            <div class="admin-form-actions">
              <%= f.submit "Approve and ship", class: "btn-admin btn-admin-success" %>
            </div>
          <% end %>
        </section>
      </div>

      <aside class="admin-actions-panel gap-1r jc-sb h-100">
        <div class="admin-card admin-actions admin-ship-request-reject-panel">
          <div class="admin-actions-title">
            <h3>Reject request</h3>
          </div>
          <p class="admin-hint">Rejecting keeps this request unshipped and marks it as denied.</p>
          <%= form_with url: reject_admin_ship_request_path(@ship_request), method: :post, local: true, data: { confirm: "Reject this request?" } do |f| %>
            <div class="form-group mb-3">
              <%= f.label :comment, "Rejection Reason", class: "admin-form-label" %>
              <div class="admin-form-control">
                <%= f.text_area :comment, rows: 3, class: "form-control", placeholder: "Enter reason for rejection...", required: true %>
              </div>
            </div>

            <%= f.submit "Reject", class: "btn-admin btn-admin-warning btn-block" %>
          <% end %>
        </div>
        <% if current_user.nda? %>
          <%= render "admin/unified_db_info", project: @ship_request.project%>
        <% end %>
      </aside>
    </div>
  <% else %>
    <% processed_at = @ship_request.approved_at || @ship_request.updated_at %>
    <% processed_by = @ship_request.processed_by&.name || @ship_request.processed_by&.email || "Unknown" %>

    <section class="admin-card admin-ship-request-card admin-ship-request-processed">
      <h2>Processed</h2>
      <p><strong>Processed at:</strong> <%= l(processed_at, format: :short) %> by <%= processed_by %></p>
    </section>
  <% end %>
</div>
