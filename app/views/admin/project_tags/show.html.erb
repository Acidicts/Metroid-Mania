<h1>Admin::ProjectTags#show</h1>
<div class="admin-panel">
  <h1>Project Tag Details</h1>

  <dl class="admin-details">
    <dt>Tag</dt>
    <dd><%= @project_tag.tag %></dd>

    <dt>Project</dt>
    <dd><%= @project_tag.project.try(:name) || "(global)" %></dd>

    <dt>Created at</dt>
    <dd><%= @project_tag.created_at %></dd>
  </dl>

  <%= link_to "Edit", edit_admin_project_tag_path(@project_tag), class: "admin-btn" %>
  <%= link_to "Back", admin_project_tags_path, class: "admin-btn admin-btn-secondary" %>
</div>
