<div class="admin-panel">
  <h1>Sale: <%= @sale.name %></h1>

  <dl class="admin-detail-list">
    <dt>Description</dt>
    <dd><%= @sale.description.presence || "(none)" %></dd>

    <dt>Product</dt>
    <dd><%= @sale.product ? @sale.product.name : "(site-wide)" %></dd>

    <dt>Quantity</dt>
    <dd><%= @sale.quantity %></dd>

    <dt>Starts at</dt>
    <dd><%= @sale.starts_at %></dd>

    <dt>Ends at</dt>
    <dd><%= @sale.ends_at || "(none)" %></dd>

    <dt>Discount (notches)</dt>
    <dd><%= @sale.discount_notches %></dd>
  </dl>

  <div class="form-actions">
    <%= link_to "Edit", edit_admin_sale_path(@sale), class: "admin-btn" %>
    <%= link_to "Back", admin_sales_path, class: "admin-btn admin-btn-secondary" %>
  </div>
</div>
