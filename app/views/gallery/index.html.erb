<% content_for :styles do %>
  <%= stylesheet_link_tag "pages/gallery-index", "data-turbo-track": "reload" %>
<% end %>

<% content_for :title, "Gallery" %>

<h1>Gallery</h1>

<div id="gallery">
  <div class="gallery-grid">
    <% @projects.each do |project| %>
      <% if project.name != "Deleted Project" %>
        <%= render project, project: @project %>
      <% end %>
    <% end %>
  </div>
</div>
<br>

