<div id="<%= dom_id comment %>" class="nb-comment">
  <div class="comment">
    <% if defined?(current_user) && current_user %>
        <strong style="font-family: var(--nb-font); font-size: 0.9rem;">
          <%= !comment.system? ? "System" : comment.user&.display_name || "Unknown User" %>
          <% if comment.user&.admin? && comment.system? %>
            <img src="https://icons.hackclub.com/api/icons/red/admin" alt="admin badge" class="nb-admin-badge" title="Admin">
          <% end %>
        </strong>
    <% else %>
        <strong style="font-family: var(--nb-font); font-size: 0.9rem;"><%= link_to "Login", hackclub_login_url %> to See User</strong>
    <% end %>
    <span class="nb-timestamp"><%= comment.created_at&.strftime("%b %-d, %Y %l:%M %P") %></span>
  </div>
  <div class="comment-box">
    <div class="comment-box-content">
        <%= markdown_to_html(comment.message) %>

        <% if defined?(current_user) && current_user && comment.editable_by?(current_user) %>
            <div class="plus-768" style="gap: 6px; align-items: center; padding: 4px; position: absolute; right: 8px;">
                <%= link_to "Edit", edit_comment_path(comment), class: "nb-btn nb-btn-secondary nb-btn-sm" %>
                <%= button_to "Delete", comment_path(comment), method: :delete, data: { confirm: "Are you sure you want to delete this comment?" }, form: { style: "display: inline; margin: 0;" }, class: "nb-btn nb-btn-danger nb-btn-sm" %>
            </div>
        <% end %>
    </div>
  </div>
</div>
