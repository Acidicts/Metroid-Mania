<div style="padding:4px; width:95%; left: 2.5%; position:relative;">
  <%= form_with(model: comment) do |form| %>
    <% if comment.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(comment.errors.count, "error") %> prohibited this comment from being saved:</h2>

        <ul>
          <% comment.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% devlog_id = (comment.respond_to?(:devlog_id) ? comment.devlog_id : nil) || (defined?(devlog) && devlog&.id) %>
    <%= form.hidden_field :devlog_id, value: devlog_id if devlog_id.present? %>
    <% ship_id = (comment.respond_to?(:ship_id) ? comment.ship_id : nil) || (defined?(ship) && ship&.id) %>
    <%= form.hidden_field :ship_id, value: ship_id if ship_id.present? %>

    <div class="field">
      <span>New Comment :</span>
      <br>
      <%= form.text_area :message, rows: 3, class: "nb-input", style: "resize: vertical;" %>
    </div>
    <br>
    <div class="actions">
      <%= form.submit "Post comment", class: "nb-btn nb-btn-primary nb-btn-sm" %>
    </div>
  <% end %>
</div>