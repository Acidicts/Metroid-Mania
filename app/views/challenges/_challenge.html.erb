<div id="<%= dom_id challenge %>">
  <div>
    <strong>Title:</strong>
    <%= challenge.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= challenge.description %>
  </div>

  <div>
    <strong>Reward notches:</strong>
    <%= challenge.reward_notches %>
  </div>

  <div>
    <strong>Start at:</strong>
    <%= challenge.start_at %>
  </div>

  <div>
    <strong>End at:</strong>
    <%= challenge.end_at %>
  </div>

  <div>
    <strong>Active:</strong>
    <%= challenge.active %>
  </div>

  <div>
    <strong>Multiplier:</strong>
    <%= challenge.multiplier %>
  </div>

</div>
