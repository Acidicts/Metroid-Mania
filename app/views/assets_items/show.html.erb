<% content_for :title, "Asset: #{@assets_item.title}" %>

<div class="retro-container">
  <div style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
    <%= link_to 'Back to Assets', assets_items_path, class: 'btn-retro' %>
    <% if @assets_item.project_id.present? %>
      <%= link_to 'View Project', assets_project_path(@assets_item.project_id), class: 'btn-retro btn-retro--outline' %>
    <% end %>
  </div>

  <section class="project-hero" style="margin-top: 18px;">
    <div class="hero-left">
      <!-- Primary Spritesheet Display (first spritesheet or legacy) -->
      <% if @assets_item.spritesheets.any? %>
        <div class="project-media" style="height: auto; max-height: none;">
          <img class="project-media__img" src="<%= @assets_item.spritesheets.first.url %>" alt="<%= @assets_item.title %> - <%= @assets_item.spritesheets.first.name %>" style="max-height: 500px;">
          <% if @assets_item.spritesheets.count > 1 %>
            <p style="margin-top: 8px; font-size: 0.9rem; color: var(--main-700);">
              Showing: <%= @assets_item.spritesheets.first.name %> (<%= @assets_item.spritesheets.count %> total spritesheets)
            </p>
          <% end %>
        </div>
      <% elsif @assets_item.spritesheet_url.present? %>
        <div class="project-media" style="height: auto; max-height: none;">
          <img class="project-media__img" src="<%= @assets_item.spritesheet_url %>" alt="<%= @assets_item.title %> spritesheet" style="max-height: 500px;">
        </div>
      <% elsif @assets_item.assets_project&.image_url.present? %>
        <div class="project-media" style="height: 280px; max-height: 280px;">
          <img class="project-media__img" src="<%= @assets_item.assets_project.image_url %>" alt="<%= @assets_item.title %>">
        </div>
      <% else %>
        <div class="project-media" style="height: 280px; max-height: 280px;">
          <div class="project-media__img" style="background: linear-gradient(135deg, var(--accent1), var(--accent2)); border-radius: 4px;"></div>
        </div>
      <% end %>

      <div style="margin-top: 12px;">
        <h1 class="project-title"><%= @assets_item.title %></h1>
        
        <div class="kv" style="margin-bottom: 12px;">
          <div class="label">By</div>
          <div class="value"><%= link_to @assets_item.user.display_name, user_profile_path(@assets_item.user) %></div>
        </div>

        <p class="project-desc" style="margin-bottom: 16px;">
          <%= simple_format(@assets_item.description || 'No description provided.') %>
        </p>

        <div class="tech-list" style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
          <% if @assets_item.media_type.present? %>
            <span class="tech"><%= @assets_item.media_type %></span>
          <% end %>
          <span class="tech" style="background: <%= @assets_item.shipped? ? 'rgba(34,197,94,0.95)' : 'var(--accent3)' %>; color: <%= @assets_item.shipped? ? '#ffffff' : 'var(--main-900)' %>;">
            <%= @assets_item.shipped? ? "Shipped" : "Unshipped" %>
          </span>
          <% if @assets_item.has_spritesheets? %>
            <span class="tech" style="background: var(--accent1);">🖼️ <%= @assets_item.spritesheets.count + (@assets_item.spritesheet_url.present? ? 1 : 0) %> Image(s)</span>
          <% end %>
          <% if @assets_item.audio.attached? %>
            <span class="tech" style="background: var(--accent2);">🔊 Audio</span>
          <% end %>
        </div>

        <!-- Audio Player -->
        <% if @assets_item.audio.attached? %>
          <div class="audio-section" style="margin-top: 16px; padding: 16px; background: linear-gradient(180deg, rgba(255,255,255,0.96), var(--accent3)); border: 3px dashed var(--main-700); border-radius: 8px;">
            <p style="margin: 0 0 8px 0; font-weight: 700; color: var(--main-900);">Audio:</p>
            <%= audio_tag @assets_item.audio, controls: true, style: "width: 100%;" %>
          </div>
        <% end %>
      </div>
    </div>

    <aside class="hero-right">
      <div class="featured-project">
        <div style="margin-top: 10px;">
          <p><strong>Project:</strong> 
            <% if @assets_item.assets_project.present? %>
              <%= link_to @assets_item.assets_project.title, assets_project_path(@assets_item.assets_project) %>
            <% else %>
              <span style="color: var(--main-700);">No project linked</span>
            <% end %>
          </p>
          <p><strong>Creator:</strong> <%= @assets_item.user.display_name %></p>
          <p><strong>Created:</strong> <%= @assets_item.created_at.strftime("%b %-d, %Y") %></p>
          <p><strong>Updated:</strong> <%= @assets_item.updated_at.strftime("%b %-d, %Y") %></p>
        </div>

        <% if current_user == @assets_item.user || admin? %>
          <div class="featured-actions" style="margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap;">
            <%= link_to 'Edit', edit_assets_item_path(@assets_item), class: 'btn-retro' %>
            <%= button_to 'Delete', @assets_item, method: :delete, class: 'btn-retro btn-retro--outline', 
                form: { data: { turbo_confirm: "Are you sure you want to delete this asset?" } } %>
          </div>
        <% end %>
      </div>
    </aside>
  </section>

  <!-- Spritesheets Section -->
  <div style="margin-top: 48px;">
    <h2 style="font-size: 1.6rem; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
      Spritesheets
      <% if current_user == @assets_item.user || admin? %>
        <%= link_to 'Add New', new_assets_item_spritesheet_path(@assets_item), class: "btn-retro", style: "font-size: 0.9rem; padding: 8px 12px;" %>
      <% end %>
    </h2>

    <% if @assets_item.spritesheets.any? || @assets_item.spritesheet_url.present? %>
      <div class="spritesheets-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 24px;">
        <!-- Legacy single spritesheet -->
        <% if @assets_item.spritesheet_url.present? %>
          <div class="spritesheet-card" style="background: linear-gradient(180deg, #fff, rgba(255,255,255,0.94)); border: 3px solid var(--main-700); border-radius: 8px; overflow: hidden; box-shadow: 8px 10px 0 var(--main-800);">
            <div class="spritesheet-image" style="background: rgba(0,0,0,0.05); padding: 12px; text-align: center;">
              <img src="<%= @assets_item.spritesheet_url %>" alt="Legacy spritesheet" style="max-width: 100%; max-height: 200px; border-radius: 6px; object-fit: cover;">
            </div>
            <div class="spritesheet-content" style="padding: 12px 16px;">
              <h4 style="margin: 0 0 8px 0; font-size: 1rem; color: var(--main-900);">Main Spritesheet</h4>
              <p style="font-size: 0.85rem; color: var(--main-700); margin-bottom: 12px;">Legacy spritesheet</p>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <%= link_to "View", @assets_item.spritesheet_url, target: "_blank", rel: "noopener", class: "btn-retro", style: "font-size: 0.85rem; padding: 6px 10px;" %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Multiple spritesheets -->
        <% @assets_item.spritesheets.each do |spritesheet| %>
          <%= render "spritesheets/spritesheet", spritesheet: spritesheet %>
        <% end %>
      </div>
    <% else %>
      <p style="color: var(--main-700); font-style: italic;">No spritesheets yet. Add one to get started!</p>
    <% end %>
  </div>
</div>
