<%= form_with(model: assets_item, html: { class: 'admin-product-form', data: { controller: 'project-url-validator' } }) do |form| %>
  <% if assets_item.errors.any? %>
    <div class="error-summary" role="alert">
      <strong><%= pluralize(assets_item.errors.count, "error") %> prohibited this assets item from being saved:</strong>
      <ul>
        <% assets_item.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="main-column">

      <!-- ── Asset Info ── -->
      <div class="apf-section">
        <div class="apf-section-title">Asset Info</div>

        <div class="form-group">
          <%= form.label :title %>
          <%= form.text_field :title, placeholder: "Short asset title", class: "form-input" %>
        </div>

        <div class="form-group">
          <%= form.label :description %>
          <%= form.text_area :description, rows: 5, placeholder: "Describe the asset and any important details", class: "form-input" %>
        </div>

        <div class="form-group">
          <%= form.label :media_type %>
          <%= form.text_field :media_type, placeholder: "e.g. sprite, audio, texture", class: "form-input" %>
          <div class="field-hint">The kind of media this asset represents.</div>
        </div>
      </div>

      <!-- ── Spritesheet (CDN) ── -->
      <div class="apf-section" data-controller="file-input">
        <div class="apf-section-title">Spritesheet Image</div>

        <div class="form-group">
          <%= form.label :spritesheet_file, "Upload spritesheet (optional)" %>
          <%= form.file_field :spritesheet_file, 
              class: "form-input file-input",
              data: { 
                file_input_target: "input",
                action: "change->file-input#update"
              },
              accept: "image/*" %>
        </div>

        <!-- Spritesheet Preview -->
        <div class="image_preview" style="margin-top: 12px;">
          <img data-file-input-target="preview" 
               src="<%= assets_item.spritesheet_url.presence || '' %>" 
               alt="Spritesheet preview" 
               style="max-width: 100%; height: auto; border-radius: 8px; object-fit: cover; <%= 'display: none;' if assets_item.spritesheet_url.blank? %>"
               class="image-preview-thumb" />
          <% if assets_item.spritesheet_url.present? %>
            <p class="form-note" style="margin-top: 8px; font-size: 0.85rem; color: var(--main-700);">Current spritesheet</p>
          <% end %>
        </div>
      </div>

      <!-- ── Audio (Active Storage) ── -->
      <div class="apf-section">
        <div class="apf-section-title">Audio File</div>

        <div class="form-group">
          <%= form.label :audio, "Upload audio (optional)" %>
          <%= form.file_field :audio, 
              class: "form-input",
              accept: "audio/*" %>
          <div class="field-hint">Supports MP3, WAV, OGG formats.</div>
        </div>

        <% if assets_item.audio.attached? %>
          <div class="audio-preview" style="margin-top: 12px;">
            <p class="form-note" style="margin-bottom: 8px; font-size: 0.85rem; color: var(--main-700);">Current audio:</p>
            <%= audio_tag assets_item.audio, controls: true, style: "width: 100%;" %>
          </div>
        <% end %>
      </div>

      <!-- ── Link to Project ── -->
      <div class="apf-section">
        <div class="apf-section-title">Project Link</div>

        <% if assets_item.project_id.present? %>
          <%= form.hidden_field :project_id %>
          <div class="field-hint">Linked to project #<%= assets_item.project_id %></div>
        <% else %>
          <div class="form-group">
            <%= form.label :project_id, "Project ID" %>
            <%= form.number_field :project_id, class: 'form-input', placeholder: "Enter project ID" %>
          </div>
        <% end %>
      </div>

      <div class="form-actions">
        <%= form.submit class: "btn-primary" %>
      </div>

    </div>
  </div>
<% end %>
