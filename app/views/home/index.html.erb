<style>
    @import url('https://fonts.googleapis.com/css2?family=Aldrich&family=Space+Grotesk:wght@400;500;700&display=swap');

    :root {
        --bg-1: #050611;
        --bg-2: #0f1230;
        --bg-3: #22072f;
        --text-1: #eff4ff;
        --text-2: #b8c3e8;
        --line: rgba(114, 232, 255, 0.36);
        --cyan: #72e8ff;
        --lime: #b6ff6b;
        --rose: #ff4db8;
        --gold: #ffd66c;
        --panel: rgba(12, 18, 52, 0.76);
    }

    h3 {
        all:unset;
    }

    h3 {
        all:unset;
        color: var(--text-2);
    }

    .ysws-landing {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        min-height: min(900px, calc(100svh - 1.5rem));
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        gap: 0.75rem;
        padding: clamp(0.85rem, 1.4vw, 1.25rem);
        border-radius: 18px;
        color: var(--text-1);
        background:
            radial-gradient(circle at 15% 18%, rgba(255, 77, 184, 0.23), transparent 34%),
            radial-gradient(circle at 80% 32%, rgba(114, 232, 255, 0.2), transparent 36%),
            linear-gradient(130deg, var(--bg-1), var(--bg-2) 52%, var(--bg-3));
        font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
    }

    .ysws-landing::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 26px 26px;
        mask-image: radial-gradient(circle at center, black 28%, transparent 92%);
        z-index: -1;
    }

    .ysws-landing::after {
        content: "";
        position: absolute;
        width: 62vmax;
        height: 62vmax;
        right: -28vmax;
        bottom: -34vmax;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(182, 255, 107, 0.22), transparent 68%);
        filter: blur(18px);
        pointer-events: none;
        z-index: -1;
    }

    .ysws-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.2rem;
    }

    .ysws-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-family: 'Aldrich', 'Trebuchet MS', sans-serif;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.93rem;
    }

    .ysws-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--lime);
        box-shadow: 0 0 12px rgba(182, 255, 107, 0.88);
    }

    .ysws-pill {
        border: 1px solid rgba(182, 255, 107, 0.52);
        background: rgba(182, 255, 107, 0.08);
        color: #eaffcf;
        border-radius: 999px;
        padding: 0.35rem 0.85rem;
        font-size: 0.82rem;
    }

    .ysws-hero {
        display: grid;
        grid-template-columns: 1.08fr 0.92fr;
        gap: clamp(0.8rem, 1.8vw, 1.3rem);
        align-items: stretch;
    }

    .ysws-canvas {
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        min-height: clamp(210px, 29vh, 320px);
        border: 1px solid var(--line);
        box-shadow: 0 0 0 1px rgba(114, 232, 255, 0.25) inset, 0 24px 48px rgba(3, 6, 20, 0.55);
    }

    .ysws-canvas img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: saturate(1.15) contrast(1.08);
    }

    .ysws-canvas::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: rgba(5, 7, 20, 0.48);
        -webkit-mask-image: linear-gradient(38deg, #000 0%, #000 24%, transparent 34%, transparent 76%, #000 86%, #000 100%);
        mask-image: linear-gradient(38deg, #000 0%, #000 24%, transparent 34%, transparent 76%, #000 86%, #000 100%);
    }

    .ysws-canvas::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(135deg, rgba(114, 232, 255, 0.2), rgba(255, 77, 184, 0.16));
        mix-blend-mode: screen;
    }

    .ysws-panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: clamp(0.9rem, 1.6vw, 1.2rem);
        backdrop-filter: blur(4px);
        box-shadow: 0 0 0 1px rgba(114, 232, 255, 0.2) inset, 0 24px 42px rgba(8, 12, 30, 0.6);
    }

    .ysws-kicker {
        margin: 0;
        color: var(--gold);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.77rem;
        font-weight: 700;
    }

    .ysws-title {
        margin: 0.25rem 0 0;
        font-family: 'Aldrich', 'Segoe UI', sans-serif;
        font-size: clamp(1.85rem, 3.8vw, 2.8rem);
        line-height: 0.98;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        text-shadow: 0 0 18px rgb(114, 231, 255);
    }

    .ysws-copy {
        margin: 0.65rem 0 0;
        color: var(--text-2);
        font-size: 0.96rem;
        line-height: 1.45;
        max-width: 44ch;
    }

    .ysws-cta-row {
        margin-top: 0.8rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        align-items: center;
    }

    .ysws-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.62rem 1rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        letter-spacing: 0.02em;
        font-size: 0.92rem;
        transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
    }

    .ysws-cta-primary {
        background: linear-gradient(100deg, var(--lime), #fff18c);
        color: #102308;
        box-shadow: 0 10px 28px rgba(182, 255, 107, 0.42);
    }

    .ysws-cta-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 36px rgba(182, 255, 107, 0.55);
    }

    .ysws-cta-secondary {
        border: 1px solid rgba(114, 232, 255, 0.65);
        color: var(--cyan);
        background: rgba(114, 232, 255, 0.08);
    }

    .ysws-cta-secondary:hover {
        transform: translateY(-2px);
        background: rgba(114, 232, 255, 0.15);
    }

    .ysws-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.7rem;
        margin-top: 0.75rem;
    }

    .ysws-stat {
        border: 1px solid rgba(114, 232, 255, 0.28);
        border-radius: 10px;
        background: rgba(9, 14, 40, 0.72);
        padding: 0.6rem;
    }

    .ysws-stat strong {
        display: block;
        font-family: 'Aldrich', 'Segoe UI', sans-serif;
        font-size: 1rem;
        color: #ffffff;
    }

    .ysws-stat span {
        color: var(--text-2);
        font-size: 0.77rem;
    }

    .ysws-lower {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 0.75rem;
        align-items: start;
    }

    .ysws-grid {
        margin-top: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.6rem;
    }

    .ysws-card {
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        padding: 0.7rem;
        background: rgba(10, 14, 38, 0.68);
    }

    .ysws-card h3 {
        margin: 0;
        font-size: 0.88rem;
        color: #fff;
        letter-spacing: 0.02em;
        font-family: 'Aldrich', 'Segoe UI', sans-serif;
        text-transform: uppercase;
    }

    .ysws-card p {
        margin: 0.3rem 0 0;
        color: var(--text-2);
        font-size: 0.78rem;
        line-height: 1.35;
    }

    .ysws-timeline {
        margin-top: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.6rem;
    }

    .ysws-step {
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 10px;
        padding: 0.62rem;
        background: rgba(16, 22, 56, 0.64);
    }

    .ysws-step small {
        color: var(--cyan);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        font-size: 0.62rem;
    }

    .ysws-step p {
        margin: 0.25rem 0 0;
        color: var(--text-2);
        font-size: 0.76rem;
        line-height: 1.3;
    }

    .ysws-footer {
        margin-top: 0;
        color: #d4ddff;
        font-size: 0.82rem;
    }

    @media (max-width: 1200px) {
        .ysws-lower {
            grid-template-columns: 1fr;
        }

        .ysws-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 1020px) {
        .ysws-landing {
            min-height: auto;
            display: block;
        }

        .ysws-hero {
            grid-template-columns: 1fr;
        }

        .ysws-canvas {
            min-height: 220px;
        }

        .ysws-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ysws-timeline {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 680px) {
        .ysws-stats {
            grid-template-columns: 1fr;
        }

        .ysws-grid,
        .ysws-timeline {
            grid-template-columns: 1fr;
        }

        .ysws-title {
            font-size: clamp(1.75rem, 10vw, 2.5rem);
        }

        .ysws-copy {
            font-size: 0.98rem;
        }

        .ysws-lower {
            display: block;
        }
    }
</style>

<section class="ysws-landing">
    <header class="ysws-top">
        <div class="ysws-brand">
            <span class="ysws-dot" aria-hidden="true"></span>
            Metroidmania YSWS
        </div>
        <span class="ysws-pill">Open to Ages 13-18 (incl.)</span>
    </header>

    <div class="ysws-hero">
        <div class="ysws-canvas">
            <%= image_tag "godot_laptop.png", alt: "Metroidvania game development illustration" %>
        </div>

        <article class="ysws-panel">
            <p class="ysws-kicker">Hack Club Open Event</p>
            <h1 class="ysws-title">Build Your Metroidvania</h1>
            <p class="ysws-copy">Build your world map, movement abilities, and combat loop, then publish devlogs as you grow. Metroidmania stays open year-round, so you can join now and ship when your build is ready.</p>

            <div class="ysws-cta-row">
                <a href="https://dev.bing-bong.uk/auth/hackclub" class="ysws-cta ysws-cta-primary">Start Building</a>
                <%= button_to "Look Around", guest_login_path, class: "ysws-cta ysws-cta-secondary", method: :get %>
            </div>

            <div class="ysws-stats">
                <div class="ysws-stat">
                    <strong>Submit Whenever You Want</strong>
                    <span>Start when and where you want</span>
                </div>
                <div class="ysws-stat">
                    <strong>Progress Milestones</strong>
                    <span>Share updates whenever you hit a milestone</span>
                </div>
                <div class="ysws-stat">
                    <strong>Real Prizes</strong>
                    <span>Earn by shipping meaningful progress</span>
                </div>
            </div>
        </article>
    </div>

    <div class="ysws-lower">
        <section class="ysws-grid" id="ysws-how" aria-label="Challenge pillars">
            <article class="ysws-card">
                <h3>Explore + Unlock</h3>
                <p>Create a map with gates, backtracking, and at least one movement unlock.</p>
            </article>
            <article class="ysws-card">
                <h3>Combat + Boss</h3>
                <p>Build one enemy archetype and one memorable boss encounter.</p>
            </article>
            <article class="ysws-card">
                <h3>Devlog it</h3>
                <p>Post progress snapshots to show how your game evolves.</p>
            </article>
        </section>

        <section class="ysws-timeline" aria-label="Open build path">
            <article class="ysws-step">
                <small>Start</small>
                <p>Set movement, rooms, and first devlog.</p>
            </article>
            <article class="ysws-step">
                <small>Expand</small>
                <p>Add unlocks, gates, and world depth.</p>
            </article>
            <article class="ysws-step">
                <small>Polish</small>
                <p>Tune combat and boss personality.</p>
            </article>
            <article class="ysws-step">
                <small>Showcase</small>
                <p>Ship when ready and share your game's story.</p>
            </article>
        </section>
    </div>

    <p class="ysws-footer">No perfect engine required. Bring your stack, your style, and ship something weird, whenever you are ready.</p>
</section>