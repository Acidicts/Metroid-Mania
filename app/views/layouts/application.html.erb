
<!DOCTYPE html>
<html lang="en">
  <head>
    <% if current_user&.font_on? %>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=DynaPuff:wght@400..700&family=Pixelify+Sans:wght@400..700&display=swap" rel="stylesheet">
    <% elsif current_user&.font_on == false %>
      <!-- OpenDyslexic for users who prefer dyslexia-friendly fonts -->
      <link href="https://fonts.cdnfonts.com/css/open-dyslexic" rel="stylesheet">
    <% end %>

    <title><%= content_for(:title) || "Metroid Mania" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Metroid Mania">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# inject Open Graph / Twitter tags when controllers set them via
        `content_for` (see projects/show and other potential pages) %>
    <% if content_for?(:og_title) %>
      <meta property="og:title" content="<%= strip_tags(content_for(:og_title)) %>">
    <% end %>
    <%# include the canonical URL if it's available (e.g. projects show) %>
    <% if request && request.original_url.present? %>
      <meta property="og:url" content="<%= request.original_url %>">
    <% end %>
    <%# description tag should always be present; fall back to a generic
        message when none was provided. each `content_for` call in views now
        guarantees a string but this double‑checks anyway. %>
    <meta property="og:description" content="<%= strip_tags(content_for(:og_description).presence || "Metroid Mania project") %>">
    <% if content_for?(:og_image) %>
      <meta property="og:image" content="<%= strip_tags(content_for(:og_image)) %>">
    <% end %>
    <% if content_for?(:twitter_card) %>
      <meta name="twitter:card" content="<%= strip_tags(content_for(:twitter_card)) %>">
    <% end %>
    <% if content_for?(:og_author) %>
      <meta property="og:author" content="<%= strip_tags(content_for(:og_author)) %>">
    <% end %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Turbo Drive is disabled in application.js to prevent frozen UI %>
    <meta name="turbo-visit-control" content="reload">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pages/application-layout", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/achievement", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/address-modal", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/charm-slot", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/comment", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/comment-box", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/devlog", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/gallery-project", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/level", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/product", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/product-card", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/project", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/wishlist", "data-turbo-track": "reload" %>
    <%= controller_stylesheet_link_tag %>
    <%= yield :styles %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= controller.controller_name %> <%= controller.action_name %> <%= 'fonts-enabled' if current_user&.font_on? %> <%= 'dyslexic' if current_user&.font_on == false %>">
    <div class="page-shell">
      <header>
        <nav class="retro-navbar">
        <button type="button" class="menu-icon" aria-label="Toggle navigation" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <%= link_to 'Home', root_path %>
        <%= link_to 'Projects', projects_path %>
        <%= link_to 'Leaderboard', leaderboard_path %>
        <%= link_to 'Gallery', gallery_path %>
        <div style="flex:1"></div>
        <% if logged_in? %>
          <div style="display: inline-flex; align-items: center;">
            <%= render 'charm_slots/loadout' %>
            <div class="profile-menu">
              <a href="<%= user_profile_path(current_user) %>" class="profile-link">
                <% if slack_profile(current_user) && slack_profile(current_user)[:image].present? %>
                  <%= image_tag slack_profile(current_user)[:image], alt: "#{current_user.name} avatar", style: "height:40px; width:40px; border-radius:999px; vertical-align:middle; margin-right:8px;" %>
                <% end %>
                <span><%= current_user.username %></span>
              </a>

              <ul class="profile-dropdown">
                <li>
                  <%= link_to 'My Profile', user_profile_path(current_user) %>
                  <%= link_to 'My Charms', charm_slots_loadout_path() %>
                  <%= link_to 'Sign out', logout_path, data: { turbo_method: :delete } %>
                </li>
              </ul>
            </div>
          </div>

          <div id="search_bar_input_container" class="search-bar-container" style="margin-left:12px; align-self:center;">
            <%= form_with url: projects_path, method: :get, local: true do |form| %>
              <%= form.text_field :q, id: "search_input", placeholder: "Search projects, users or #tag...", class: "search-input" %>
            <% end %>
            <ul id="search_suggestions" class="search-suggestions" aria-label="Search suggestions"></ul>
          </div>

          <img id="search-icon" src="https://icons.hackclub.com/api/icons/red/search" style="width:32px; height:32px; margin-left:12px; opacity:0.8;" alt="Search icon" onclick="document.getElementById('search_input').focus();" class="search-icon">

          <script>
            document.addEventListener('DOMContentLoaded', function() {
              var searchIcon = document.getElementById('search-icon');
              var searchInput = document.getElementById('search_input');
              var suggestionBox = document.getElementById('search_suggestions');
              var searchForm = searchInput && searchInput.closest('form');

              // show / hide input on icon click (mobile friendly)
              searchIcon.addEventListener('click', function() {
                if (searchInput.style.display === 'block') {
                  searchInput.style.display = 'none';
                } else {
                  searchInput.style.display = 'block';
                  searchInput.focus();
                }
              });

              searchInput.style.display = 'none'; // start hidden for icon

              // collapse when losing focus (allow click on suggestions first)
              searchInput.addEventListener('blur', function() {
                setTimeout(function() {
                  suggestionBox.classList.remove('visible');
                }, 150);
              });

              // helper for creating suggestion item
              function makeSuggestionItem(item) {
                var li = document.createElement('li');
                var badge = document.createElement('span');
                badge.className = 'badge badge-' + item.type;
                badge.textContent = item.type;
                var textSpan = document.createElement('span');
                textSpan.textContent = item.text;
                li.appendChild(badge);
                li.appendChild(textSpan);
                li.addEventListener('mousedown', function(e) {
                  // mousedown so input doesn't blur before click
                  searchInput.value = item.text;
                  suggestionBox.classList.remove('visible');
                  if (searchForm) searchForm.submit();
                });
                return li;
              }

              // debounce helper
              var debounceTimeout;
              function fetchSuggestions(q) {
                if (!q) {
                  suggestionBox.classList.remove('visible');
                  return;
                }
                fetch('/projects/suggestions?q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } })
                  .then(function(res) { return res.json(); })
                  .then(function(arr) {
                    suggestionBox.innerHTML = '';
                    arr.forEach(function(item) { suggestionBox.appendChild(makeSuggestionItem(item)); });
                    if (arr.length) suggestionBox.classList.add('visible');
                    else suggestionBox.classList.remove('visible');
                  })
                  .catch(function() { suggestionBox.classList.remove('visible'); });
              }

              searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(function() { fetchSuggestions(searchInput.value); }, 200);
              });
            });
          </script>

          <noscript>
            <form action="<%= logout_path %>" method="post" style="display:inline">
              <input type="hidden" name="_method" value="delete" />
              <input type="submit" value="Sign out" class="btn-retro" />
            </form>
          </noscript>
        <% else %>
          <button onclick="window.location.href='<%= hackclub_login_url %>'" data-turbo="false" style="font-family: 'Phantom Sans'; font-size:1rem; color:black; background:#ec3750; border:2px solid var(--main-800); cursor:pointer;" class="btn-retro pixelify-sans">Login</button>
        <% end %>
      </nav>
    </header>

    <% unless feature_enabled?(:running) %>
      <div class="site-banner" role="status" style="background:#fff4e5;color:#4b2e00;padding:10px;text-align:center;border-top:4px solid #ffd8a8;">
        <%= @not_running_message %> – RSVP <%= link_to "here", rsvp_path, style: "color:#0b4a7f;text-decoration:underline;" %>. <% if admin? %> <%= link_to "Manage site settings", admin_site_settings_path, style: "color:#0b4a7f;text-decoration:underline;" %> <% end %>
      </div>
    <% end %>

    <% unless feature_enabled?(:shop) %>
      <div class="site-banner" role="status" style="background:#fff4e5;color:#4b2e00;padding:10px;text-align:center;border-top:4px solid #ffd8a8;">
        Store is currently disabled. <% if admin? %> <%= link_to "Manage site settings", admin_site_settings_path, style: "color:#0b4a7f;text-decoration:underline;" %> <% end %>
      </div>
    <% end %>

    <% if user_has_prize?(current_user) %>
      <div class="site-banner" role="status" style="background:#fff4e5;color:#4b2e00;padding:10px;text-align:center;border-top:4px solid #ffd8a8;">
        You have won the weekly goal prize. <%= link_to "View your prize", prize_order_for(current_user), style: "color:#0b4a7f;text-decoration:underline;" %> <% if admin? %> <%= link_to "Manage site settings", admin_site_settings_path, style: "color:#0b4a7f;text-decoration:underline;" %> <% end %>
      </div>
    <% end %>

    <%= render 'shared/flash' %>

    <% if current_user && !current_user.setup? %>
      <%= render 'application/on_start/guide' %>
    <% end %>

    <main class="retro-container" role="main" style="padding-top:18px; padding-bottom:18px;">
      <%= yield %>
    </main>

    <footer class="retro-footer">
      <div class="retro-container">
        <strong>Metroid Mania</strong>
        <p>Made for Hackclub</p>
      </div>
    </footer>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Profile dropdown menu
        var profileLink = document.querySelector('.profile-link');
        var dropdown = document.querySelector('.profile-dropdown');
        var profileMenu = document.querySelector('.profile-menu');

        if (profileLink && dropdown && profileMenu) {
          profileLink.addEventListener('click', function(e) {
            e.preventDefault();
            // position dropdown to avoid going off-screen
            var rect = profileLink.getBoundingClientRect();
            var dropdownRect = dropdown.getBoundingClientRect();
            var viewportWidth = window.innerWidth || document.documentElement.clientWidth;

            if (rect.right + dropdownRect.width > viewportWidth) {
              dropdown.style.left = 'auto';
              dropdown.style.right = '0';
            } else {
              dropdown.style.left = '0';
              dropdown.style.right = 'auto';
            }

            dropdown.classList.toggle('open');
          });

          // Hide dropdown when clicking outside
          document.addEventListener('click', function(e) {
            if (!profileMenu.contains(e.target)) {
              dropdown.classList.remove('open');
            }
          });
        }
      });

      // Mobile menu toggle: accessible + robust across Turbo navigation
      (function() {
        function initMobileMenu() {
          var menu = document.querySelector('.menu-icon');
          var nav = document.querySelector('.retro-navbar');
          if (!menu || !nav) return;

          // If it's not a native button, add accessibility attributes
          if (menu.tagName !== 'BUTTON') {
            menu.setAttribute('role','button');
            menu.setAttribute('tabindex','0');
          }
          if (!menu.hasAttribute('aria-expanded')) menu.setAttribute('aria-expanded','false');

          // helpers
          function setOpen(open) {
            if (open) {
              nav.classList.add('expanded');
              menu.classList.add('open');
              menu.setAttribute('aria-expanded','true');
            } else {
              nav.classList.remove('expanded');
              menu.classList.remove('open');
              menu.setAttribute('aria-expanded','false');
            }
            // prevent body scrolling when the mobile nav is open
            document.body.classList.toggle('nav-open', !!open);
          }

          function toggle() { setOpen(!nav.classList.contains('expanded')); }

          // Remove any prior handlers to avoid duplicates when re-initializing
          if (menu._mobileMenuClick) menu.removeEventListener('click', menu._mobileMenuClick);
          if (menu._mobileMenuKeydown) menu.removeEventListener('keydown', menu._mobileMenuKeydown);
          if (document._mobileMenuDocClick) document.removeEventListener('click', document._mobileMenuDocClick);
          if (window._mobileMenuResize) window.removeEventListener('resize', window._mobileMenuResize);

          // assign handlers as properties for later removal
          menu._mobileMenuClick = function(e) { e.preventDefault(); toggle(); };
          menu._mobileMenuKeydown = function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } };
          document._mobileMenuDocClick = function(e) {
            if (window.innerWidth <= 600 && nav.classList.contains('expanded')) {
              if (!nav.contains(e.target) && !menu.contains(e.target)) { setOpen(false); }
            }
          };
          window._mobileMenuResize = function() { if (window.innerWidth > 600 && nav.classList.contains('expanded')) setOpen(false); };

          menu.addEventListener('click', menu._mobileMenuClick);
          menu.addEventListener('keydown', menu._mobileMenuKeydown);
          document.addEventListener('click', document._mobileMenuDocClick);
          window.addEventListener('resize', window._mobileMenuResize);

          // close the menu when a nav link is clicked (ensures clean state before navigation)
          if (!nav._navLinkClickBound) {
            nav._navLinkClickBound = true;
            nav.addEventListener('click', function(e) {
              var a = e.target.closest('a');
              if (a && window.innerWidth <= 600) {
                setOpen(false);
              }
            });
          }

          if (!document._turboBeforeCacheBound) {
            document._turboBeforeCacheBound = true;
            document.addEventListener('turbo:before-cache', function() { setOpen(false); });
            document.addEventListener('turbolinks:before-cache', function() { setOpen(false); });
          }
        }

        document.addEventListener('DOMContentLoaded', initMobileMenu);
        document.addEventListener('turbo:load', initMobileMenu);
        document.addEventListener('turbolinks:load', initMobileMenu);

        document.addEventListener('keydown', function() {
          // populated from ENV['DISALLOWED_WORDS'] (accepts JSON array or comma-separated string)
          var DISALLOWED = <%= begin
            v = ENV['DISALLOWED_WORDS']
            if v.present?
              begin
                JSON.parse(v)
              rescue
                v.split(',').map(&:strip)
              end
            else
              []
            end
          end.to_json.html_safe %>;

          function escapeRegExp(s) { return s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\$&'); }

          function isTextEditable(el) {
            if (!el) return false;
            if (el.isContentEditable) return true;
            if (el.tagName === 'TEXTAREA') return true;
            if (el.tagName === 'INPUT') {
              var t = el.type;
              return ['text','search','email','url','tel'].indexOf(t) !== -1;
            }
            return false;
          }

          function removeDisallowedFromInput(el) {
            var val = el.value;
            var original = val;
            var selStart = el.selectionStart;
            var selEnd = el.selectionEnd;

            var removedBeforeStart = 0;
            var removedBeforeEnd = 0;

            DISALLOWED.forEach(function(word) {
              var re = new RegExp('\\b' + escapeRegExp(word) + '\\b', 'gi');
              var m;
              while ((m = re.exec(val)) !== null) {
                var idx = m.index;
                var len = m[0].length;
                if (idx < selStart) removedBeforeStart += len;
                if (idx < selEnd) removedBeforeEnd += len;
              }
              val = val.replace(re, '');
            });

            if (val !== original) {
              el.value = val;
              try {
                var newStart = Math.max(0, selStart - removedBeforeStart);
                var newEnd = Math.max(newStart, selEnd - removedBeforeEnd);
                el.setSelectionRange(newStart, newEnd);
              } catch (err) {}
              el.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }

          function removeDisallowedFromContentEditable(el) {
            var sel = window.getSelection();
            if (!sel || sel.rangeCount === 0) return;
            var range = sel.getRangeAt(0);
            var node = range.startContainer;
            if (node.nodeType !== Node.TEXT_NODE) {
              var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
              var found = null;
              while (walker.nextNode()) {
                var txt = walker.currentNode.nodeValue;
                for (var i = 0; i < DISALLOWED.length; i++) {
                  var r = new RegExp('\\b' + escapeRegExp(DISALLOWED[i]) + '\\b', 'i');
                  if (r.test(txt)) { found = walker.currentNode; break; }
                }
                if (found) break;
              }
              if (!found) return;
              node = found;
            }

            var text = node.nodeValue;
            var original = text;
            var offset = range.startOffset;
            var removedBeforeOffset = 0;

            DISALLOWED.forEach(function(word) {
              var re = new RegExp('\\b' + escapeRegExp(word) + '\\b', 'gi');
              var m;
              while ((m = re.exec(text)) !== null) {
                var idx = m.index;
                var len = m[0].length;
                if (idx < offset) removedBeforeOffset += len;
              }
              text = text.replace(re, '');
            });

            if (text !== original) {
              node.nodeValue = text;
              var newOffset = Math.max(0, offset - removedBeforeOffset);
              var newRange = document.createRange();
              newRange.setStart(node, Math.min(newOffset, node.nodeValue.length));
              newRange.collapse(true);
              sel.removeAllRanges();
              sel.addRange(newRange);
              el.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }

          document.addEventListener('keydown', function(e) {
            if (e.isComposing) return;
            var t = e.target;
            if (!isTextEditable(t)) return;
            // don't process passwords
            if (t.tagName === 'INPUT' && t.type === 'password') return;

            // run immediately after the key updates the value
            setTimeout(function() {
              if (!t) return;
              if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA') {
                removeDisallowedFromInput(t);
              } else if (t.isContentEditable) {
                removeDisallowedFromContentEditable(t);
              }
            }, 0);
          }, true);
        })();
      })();

      // Ensure page is always interactive (safety check)
      // With Turbo Drive disabled, this is just a precaution
      (function() {
        function ensureInteractive() {
          // Ensure pointer events are enabled
          if (document.body.style.pointerEvents === 'none') {
            document.body.style.pointerEvents = '';
          }
          if (document.documentElement.style.pointerEvents === 'none') {
            document.documentElement.style.pointerEvents = '';
          }
        }

        // Run on page load
        document.addEventListener('DOMContentLoaded', ensureInteractive);
        ensureInteractive();
      })();
    </script>
  </body>
</html>
