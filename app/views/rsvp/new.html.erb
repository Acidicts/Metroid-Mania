<% content_for :styles do %>
  <%= stylesheet_link_tag "pages/rsvp-new", "data-turbo-track": "reload" %>
<% end %>

<div class="rsvp-page">
  <div class="rsvp-form">
    <h1>RSVP to Metroidvania!</h1>
    <p>Let us know you'll be participating!</p>

    <%= form_for @rsvp, html: { class: 'rsvp-form__form' }, local: true do |form| %>
      <div class="actions">
        <%= form.submit "RSVP", class: "button" %>
      </div>
    <% end %>
  </div>
</div>