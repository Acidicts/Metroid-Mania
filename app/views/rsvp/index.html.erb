<% content_for :styles do %>
  <%= stylesheet_link_tag "pages/rsvp-index", "data-turbo-track": "reload" %>
<% end %>

<% content_for :title, "Metroidmania" %>
<% content_for :og_title, "Metroidmania" %>
<% content_for :og_description, "RSVP to Metroidmania!" %>
<% content_for :og_image, image_url("og_banner.png") %>
<% content_for :twitter_card, "summary_large_image" %>
<% content_for :og_author, "Alex & Lenny" %>

<div class="rsvp-page">
  <h1>RSVP to Metroidvania to show your support!</h1>

  <div class="rsvp-count">
    <p><span style="font-family: monospace; font-weight: bold;"><%= @rsvp_count %></span> people have RSVPed!</p>
  </div>

  <p>Be the next one — <a href="/rsvp/new">RSVP Now</a></p>
</div>