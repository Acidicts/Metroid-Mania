<style>
  .rsvp-page {
    max-width: 640px;
    margin: 56px auto;
    padding: 36px 28px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 212, 163, 0.18));
    border: 1px solid rgba(13, 43, 69, 0.12);
    border-radius: 28px;
    box-shadow: 0 24px 64px rgba(13, 43, 69, 0.16);
  }

  .rsvp-page h1 {
    margin: 0 0 20px;
    font-size: clamp(2rem, 3.4vw, 2.4rem);
    color: var(--main-900);
    text-align: center;
    letter-spacing: -0.03em;
  }

  .rsvp-page .rsvp-count {
    display: inline-flex;
    margin: 0 auto 24px;
    padding: 16px 22px;
    border-radius: 999px;
    background: rgba(255, 212, 163, 0.22);
    color: var(--main-900);
    font-size: 1.1rem;
    font-weight: 700;
    text-align: center;
    width: 90%;
  }

  .rsvp-page p {
    margin: 0;
    color: var(--main-700);
    text-align: center;
    font-size: 1rem;
    line-height: 1.75;
  }

  .rsvp-page a {
    color: var(--accent1);
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .rsvp-page a:hover {
    color: var(--accent2);
  }
</style>

<% content_for :title, "Metroidmania" %>
<% content_for :og_title, "Metroidmania" %>
<% content_for :og_description, "RSVP to Metroidmania!" %>
<% content_for :og_image, image_url("og_banner.png") %>
<% content_for :twitter_card, "summary_large_image" %>
<% content_for :og_author, "Alex & Lenny" %>

<div class="rsvp-page">
  <h1>RSVP to Metroidvania to show your support!</h1>

  <div class="rsvp-count">
    <p><span style="font-family: monospace; font-weight: bold;"><%= @rsvp_count %></span> people have RSVPed!</p>
  </div>

  <p>Be the next one — <a href="/rsvp/new">RSVP Now</a></p>
</div>