<% content_for :title, "New devlog" %>

<div style="max-width: 680px; margin: 0 auto;">
  <h1 class="nb-page-title">New devlog for <%= @project.name %></h1>
  <span class="nb-chip" style="margin-bottom: 20px;">⏱ Time: <%= @project.time %></span>

  <div class="nb-card" style="margin-top: 20px;">
    <%= render "form", devlog: @devlog %>
  </div>

  <div class="nb-linkbar" style="margin-top: 24px;">
    <%= link_to "← Back to project", project_path(@project), class: "nb-link" %>
  </div>
</div>
