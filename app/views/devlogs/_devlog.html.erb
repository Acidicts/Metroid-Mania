<style>
  #comments-for {
    margin-top: 16px;
    padding-top: 16px;
    border: 2px dashed var(--accent2);
    border-radius: 8px;
  }
</style>

<div class="nb-timeline-item">
  <% if devlog.user.present? %>
    <div class="nb-timeline-dot dot-devlog"></div>
  <% end %>

  <div id="<%= dom_id devlog %>" class="nb-card card-devlog">
    <div class="nb-meta">
      <span class="nb-badge badge-devlog">Devlog</span>
      <% if devlog.user.present? %>
        <strong style="font-family: var(--nb-font); font-size: 0.95rem;"><%= devlog.user.display_name %></strong>
      <% else %>
        <strong style="font-family: var(--nb-font); font-size: 0.95rem;"><%= devlog.project.user.display_name %></strong>
      <% end %>
      <span class="nb-timestamp"><%= devlog.log_date&.strftime("%b %-d, %Y") %></span>
    </div>

    <div class="nb-title"><%= devlog.title %></div>

    <div class="nb-content">
      <%= markdown_to_html(devlog.content) %>
    </div>

    <% if devlog.duration_seconds_total.to_i > 0 %>
      <span class="nb-chip">⏱ <%= format_duration(devlog.duration_seconds_total.to_i) %></span>
    <% end %>

    <div class="nb-linkbar">
      <% if devlog.ship_request.present? %>
        <span class="nb-badge badge-auto">Auto-generated</span>
      <% end %>

      <% if defined?(current_user) && current_user && devlog.editable_by?(current_user) %>
        <div style="display: inline-flex; gap: 6px; align-items: center;">
          <%= link_to "Edit", edit_project_devlog_path(devlog.project, devlog), class: "nb-btn nb-btn-secondary nb-btn-sm" %>
          <%= button_to "Delete", [devlog.project, devlog], method: :delete, data: { confirm: "Are you sure you want to delete this devlog?" }, form: { style: "display: inline; margin: 0;" }, class: "nb-btn nb-btn-danger nb-btn-sm" %>
        </div>
      <% end %>
    </div>
    <hr style="margin: 16px 0;">
    <div id="comments-for">
      <% for comment in devlog.comments %>
        <%= render comment %>
      <% end %>
      <% if defined?(current_user) && current_user %>
        <%= render 'comments/form', comment: Comment.new(devlog: devlog), devlog: devlog %>
      <% end %>
    </div>
  </div>
</div>
