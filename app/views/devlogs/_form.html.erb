<%= form_with(model: [@project, devlog]) do |form| %>
  <% if devlog.errors.any? %>
    <div class="nb-errors">
      <h2><%= pluralize(devlog.errors.count, "error") %> prohibited this devlog from being saved:</h2>

      <ul>
        <% devlog.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Project ID is set via nesting %>

  <div class="nb-form-group">
    <%= form.label :title, class: "nb-label" %>
    <%= form.text_field :title, class: "nb-input" %>
  </div>

  <div class="nb-form-group">
    <%= form.label :content, class: "nb-label" %>
    <%= form.text_area :content, rows: 5, class: "nb-textarea" %>
  </div>

  <div class="nb-form-group">
    <span class="nb-label">Duration</span>
    <% if devlog.duration_minutes.present? %>
      <span class="nb-chip">⏱ <%= format_duration(devlog.duration_minutes * 60) %></span>
    <% else %>
      <p class="nb-empty">Not available</p>
    <% end %>
    <p style="font-family: var(--nb-font); font-size: 0.82rem; color: #6b7280; margin-top: 6px;">Duration is automatically calculated from remaining undocumented time and cannot be edited.</p>
  </div>

  <div class="nb-form-group">
    <%= form.submit class: "nb-btn nb-btn-primary" %>
  </div>
<% end %>
