<% if notice.present? %>
  <div class="nb-card" style="border-left: 8px solid var(--nb-green); margin-bottom: 24px; padding: 14px 20px;">
    <strong style="font-family: var(--nb-font); color: var(--nb-green);">✓</strong>
  </div>
<% end %>

<% content_for :title, "Devlogs for #{@project.name}" %>

<h1 class="nb-page-title">Devlogs for <%= @project.name %></h1>

<div id="devlogs" class="nb-timeline">
  <% # Build a single array of markers (ships only) sorted by time desc %>
  <% markers = [] %>
  <% @ships&.each do |s| %>
    <% markers << { type: 'ship', time: s.shipped_at || s.created_at, obj: s } %>
  <% end %>
  <% markers.sort_by! { |m| m[:time] || Time.at(0) }.reverse! %>

  <% markers = markers.to_a %>

  <% # Merge markers and devlogs into a single timeline ordered by date (latest first)
    devlogs = @devlogs.to_a
    markers = markers.to_a

    while devlogs.any? || markers.any? %>

      <%# Compute next devlog time (date) and next marker time (date) for comparison %>
        <% next_devlog = devlogs.first %>
      <% next_marker = markers.first %>

      <%# Use precise timestamps for ordering so recently created devlogs appear above markers when appropriate %>
      <% next_devlog_time = next_devlog ? next_devlog.created_at : nil %>
      <% next_marker_time = next_marker ? next_marker[:time] : nil %>

      <% if next_marker && (next_devlog.nil? || (next_marker_time && next_devlog_time && next_marker_time > next_devlog_time) || (next_marker_time && next_devlog_time.nil?)) %>
        <% m = markers.shift %>
        <% ship = m[:obj] %>
        <%= render partial: 'devlogs/ship', locals: { ship: ship } %>

      <% else %>
        <%# Render the next devlog normally %>
        <% d = devlogs.shift %>
        <%= render d %>
        <div class="nb-linkbar" style="margin-left: 40px; margin-bottom: 18px;">
          <%= link_to "Show this devlog →", project_devlog_path(@project, d), class: "nb-link" %>
        </div>
      <% end %>

    <% end %>

  <%# Any remaining markers that happened after the last devlog (most recent) - already handled in loop %>
</div>

<div style="margin-top: 32px;">
  <%= link_to "＋ New devlog", new_project_devlog_path(@project), class: "nb-btn nb-btn-primary" %>
</div>
