<p style="color: green"><%= notice %></p>

<% content_for :title, "Devlogs for #{@project.name}" %>

<h1>Devlogs for <%= @project.name %></h1>

<div id="devlogs" class="timeline">
  <% # Build a single array of markers (both ship requests and ships) sorted by time desc %>
  <% markers = [] %>
  <% @ship_requests&.each do |r| %>
    <% markers << { type: 'request', time: r.requested_at || r.created_at, obj: r } %>
  <% end %>
  <% @ships&.each do |s| %>
    <% markers << { type: 'ship', time: s.shipped_at || s.created_at, obj: s } %>
  <% end %>
  <% markers.sort_by! { |m| m[:time] || Time.at(0) }.reverse! %>

  <% markers = markers.to_a %>

  <% # Merge markers and devlogs into a single timeline ordered by date (latest first)
    devlogs = @devlogs.to_a
    markers = markers.to_a

    while devlogs.any? || markers.any? %>

      <%# Compute next devlog time (date) and next marker time (date) for comparison %>
        <% next_devlog = devlogs.first %>
      <% next_marker = markers.first %>

      <%# Use precise timestamps for ordering so recently created devlogs appear above markers when appropriate %>
      <% next_devlog_time = next_devlog ? next_devlog.created_at : nil %>
      <% next_marker_time = next_marker ? next_marker[:time] : nil %>

      <% if next_marker && (next_devlog.nil? || (next_marker_time && next_devlog_time && next_marker_time > next_devlog_time) || (next_marker_time && next_devlog_time.nil?)) %>
        <% m = markers.shift %>
        <% if m[:type] == 'ship' %>
          <%= render partial: 'devlogs/ship', locals: { ship: m[:obj] } %>
        <% else %>
          <%# Render ship request marker and then its linked user-created devlogs (in order)
             sr = m[:obj]
          %>
          <%= render partial: 'devlogs/ship_request', locals: { ship_request: sr, project: @project } %>

          <%# Render linked user devlogs (and remove them from main list) %>
          <% sr.devlogs.order(log_date: :desc, created_at: :desc).each do |linked| %>
            <% next if linked.user.nil? %>
            <%# Remove the linked devlog from the devlogs list if present so we don't render it twice %>
            <% if (idx = devlogs.index { |d| d.id == linked.id }) %>
              <% devlogs.delete_at(idx) %>
            <% end %>
            <%= render linked %>
            <p>
              <%= link_to "Show this devlog", project_devlog_path(@project, linked) %>
            </p>
          <% end %>
        <% end %>

      <% else %>
        <%# Render the next devlog normally %>
        <% d = devlogs.shift %>
        <%= render d %>
        <p>
          <%= link_to "Show this devlog", project_devlog_path(@project, d) %>
        </p>
      <% end %>

    <% end %>

  <%# Any remaining markers that happened after the last devlog (most recent) - already handled in loop %>
</div>

<%= link_to "New devlog", new_project_devlog_path(@project) %>
