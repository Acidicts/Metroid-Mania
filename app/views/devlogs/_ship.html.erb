<div class="nb-timeline-item">
  <div class="nb-timeline-dot dot-ship"></div>
  <div id="ship_<%= ship.id %>" class="nb-card card-ship">
    <% ship_number = ship.project.ships.where('shipped_at <= ?', ship.shipped_at).count %>
    <div class="nb-meta">
      <span class="nb-badge badge-ship">🚀 Ship <%= ship_number %></span>
      <span class="nb-timestamp"><%= ship.shipped_at&.strftime("%b %-d, %Y %l:%M %p") %></span>
    </div>

    <% req = ship.project.ship_requests.where(status: 'approved').where(approved_at: ship.shipped_at).or(ship.project.ship_requests.where('requested_at <= ?', ship.shipped_at)).order(approved_at: :desc, requested_at: :desc).first %>

    <% hours = (ship.devlogged_seconds.to_i / 3600.0).round(2) %>
    <% credits_display = ship.credits_awarded.to_f > 0 ? format_credits(ship.credits_awarded) : "-" %>
    <% multiplier_display = if ship.respond_to?(:multiplier) && ship.multiplier.present?
                               ship.multiplier
                             elsif req && req.respond_to?(:multiplier) && req.multiplier.present?
                               req.multiplier
                             else
                               "-"
                             end %>
    <% devlogs_count = req ? req.devlogs.where.not(user_id: nil).count : 0 %>

    <div class="nb-stats">
      <div class="nb-stat">
        <span class="nb-stat-label">Hours</span>
        <span class="nb-stat-value"><%= hours %></span>
      </div>
      <div class="nb-stat">
        <span class="nb-stat-label">Credits</span>
        <span class="nb-stat-value"><%= credits_display %></span>
      </div>
      <div class="nb-stat">
        <span class="nb-stat-label">Multiplier</span>
        <span class="nb-stat-value"><%= multiplier_display %></span>
      </div>
      <div class="nb-stat">
        <span class="nb-stat-label">Devlogs</span>
        <span class="nb-stat-value"><%= devlogs_count %></span>
      </div>
    </div>
    <span>Devlogs Included :</span>
    <% if req && req.devlogs.any? %>
      <ul class="nb-devlog-list">
        <% req.devlogs.order(log_date: :desc).each do |d| %>
          <% next if d.user.nil? %>
          <li>
            <%= link_to(d.title.presence || "Devlog ##{d.id}", project_devlog_path(ship.project, d)) %>
            <span class="nb-timestamp"><%= d.log_date || d.created_at %> · <%= format_duration(d.duration_seconds_total.to_i) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="nb-empty">No linked devlogs.</p>
    <% end %>

    <% if defined?(current_user) && current_user && (current_user&.admin? || current_user == ship.project.user) %>
      <hr style="margin: 16px 0;">
      <div id="comments-for">
        <% ship.comments.each do |comment| %>
          <%= render comment %>
        <% end %>

        <% if current_user&.admin? %>
          <%= render 'comments/form', comment: Comment.new(ship: ship), ship: ship %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
