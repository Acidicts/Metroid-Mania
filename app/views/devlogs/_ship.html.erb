<div class="timeline-item">
  <div class="timeline-card" style="margin-left:72px">
    <div id="ship_<%= ship.id %>" class="devlog ship">
      <% ship_number = ship.project.ships.where('shipped_at <= ?', ship.shipped_at).count %>
      <div class="meta"><div class="who">Ship <%= ship_number %></div><div class="when"><small><%= ship.shipped_at&.strftime("%b %-d, %Y %l:%M %p") %></small></div></div>

      <div class="devlog-content">
        <% req = ship.project.ship_requests.where(status: 'approved').where(approved_at: ship.shipped_at).or(ship.project.ship_requests.where('requested_at <= ?', ship.shipped_at)).order(approved_at: :desc, requested_at: :desc).first %>

        <% hours = (ship.devlogged_seconds.to_i / 3600.0).round(2) %>
        <% credits_display = ship.credits_awarded.to_f > 0 ? format_credits(ship.credits_awarded) : "-" %>
        <% multiplier_display = if ship.respond_to?(:multiplier) && ship.multiplier.present?
                                   ship.multiplier
                                 elsif req && req.respond_to?(:multiplier) && req.multiplier.present?
                                   req.multiplier
                                 else
                                   "-"
                                 end %>
        <% devlogs_count = req ? req.devlogs.where.not(user_id: nil).count : 0 %>

        <div style="display:flex; gap:18px;">
          <div><strong>Hours :</strong> <span style="font-family:monospace;"><%= hours %></span></div>
          <div><strong>Credits:</strong> <%= credits_display %></div>
          <div><strong>Multiplier:</strong> <%= multiplier_display %></div>
          <div><strong>Devlogs:</strong> <%= devlogs_count %></div>
        </div>

        <% if req && req.devlogs.any? %>
          <div style="margin-top:6px;">
            <% req.devlogs.order(log_date: :desc).each do |d| %>
              <% next if d.user.nil? %>
              <div style="margin-top:6px"><%= link_to(d.title.presence || "Devlog ##{d.id}", project_devlog_path(ship.project, d)) %> — <%= d.log_date || d.created_at %> (<%= format_duration(d.duration_minutes * 60) %>)</div>
            <% end %>
          </div>
        <% else %>
          <div style="margin-top:6px"><em>No linked devlogs.</em></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
