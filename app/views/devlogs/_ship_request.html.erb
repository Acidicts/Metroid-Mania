<div class="nb-timeline-item">
  <div class="nb-timeline-dot dot-request"></div>
  <div id="<%= dom_id ship_request %>" class="nb-card card-ship-request">
    <div class="nb-meta">
      <% if (ship = ship_request.associated_ship) %>
        <% ship_number = ship.project.ships.where('shipped_at <= ?', ship.shipped_at).count %>
        <span class="nb-badge badge-request">Ship <%= ship_number %></span>
        <span class="nb-timestamp"><%= ship.shipped_at&.strftime("%b %-d, %Y %l:%M %p") || (ship_request.requested_at || ship_request.created_at)&.strftime("%b %-d, %Y %l:%M %p") %></span>
      <% else %>
        <span class="nb-badge badge-request">Request #<%= ship_request.id %></span>
        <span class="nb-timestamp"><%= (ship_request.requested_at || ship_request.created_at)&.strftime("%b %-d, %Y %l:%M %p") %></span>
      <% end %>
    </div>

    <div class="nb-stats">
      <div class="nb-stat">
        <span class="nb-stat-label">Hours</span>
        <span class="nb-stat-value"><%= (ship_request.devlogged_seconds.to_i / 3600.0).round(2) %></span>
      </div>
      <div class="nb-stat">
        <span class="nb-stat-label">Credits</span>
        <span class="nb-stat-value"><%= (ship_request.credits_awarded.presence || (ship_request.associated_ship&.credits_awarded)).present? ? format_credits(ship_request.credits_awarded.presence || (ship_request.associated_ship&.credits_awarded)) : "-" %></span>
      </div>
      <div class="nb-stat">
        <span class="nb-stat-label">Devlogs</span>
        <span class="nb-stat-value"><%= ship_request.devlogs.where.not(user_id: nil).count %></span>
      </div>
    </div>

    <% if ship_request.devlogs.any? %>
      <ul class="nb-devlog-list">
        <% ship_request.devlogs.order(log_date: :desc).each do |d| %>
          <% next if d.user.nil? %>
          <li>
            <%= link_to(d.title.presence || "Devlog ##{d.id}", project_devlog_path(project, d)) %>
            <span class="nb-timestamp"><%= d.log_date || d.created_at %> · <%= format_duration(d.duration_seconds_total.to_i) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div class="nb-linkbar">
      <%= link_to "View Request →", project_ship_request_path(project, ship_request), class: "nb-btn nb-btn-primary nb-btn-sm" %>
    </div>
  </div>
</div>
