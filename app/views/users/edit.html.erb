<% content_for :styles do %>
  <%= stylesheet_link_tag "products", "data-turbo-track": "reload" %>
<% end %>

<% content_for :title, "Edit profile" %>

<div class="project-form-card">
  <h1>Edit profile</h1>

  <%= form_with model: @user, url: profile_path, method: :patch, html: { class: "admin-product-form" } do |f| %>
    <% if @user.errors.any? %>
      <div class="error-summary" role="alert">
        <strong><%= pluralize(@user.errors.count, "error") %> prohibited this profile from being saved:</strong>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <div class="checkbox-card">
        <%= f.check_box :font_on, id: "font_on_toggle" %>
        <%= f.label :font_on, "Enable Custom Fonts", for: "font_on_toggle" %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :set_region, "Select Your Region" %>
      <%= f.select :set_region, options_for_select(User::REGIONS.map { |r| [r, r] }, @user.set_region.presence || @user.region), { include_blank: "Choose a region" }, class: "form-input" %>
    </div>

    <div class="apf-section">
      <div class="apf-section-title">Address</div>

      <% addresses = @user.address.to_a %>
      <% if addresses.any? %>
        <div class="form-group">
          <label>Select Address to Edit</label>
          <div class="inline g2r w100p">
            <select id="address-picker" style="width:95%" class="form-input">
              <% addresses.each_with_index do |addr, i| %>
                <option value="<%= i %>"
                  data-id="<%= addr.id %>"
                  data-line1="<%= addr.address_line_1.to_s %>"
                  data-line2="<%= addr.address_line_2.to_s %>"
                  data-city="<%= addr.city.to_s %>"
                  data-province="<%= addr.province.to_s %>"
                  data-postal="<%= addr.postal_code.to_s %>"
                  data-country="<%= addr.country.to_s %>">
                  <%= [addr.address_line_1, addr.city, addr.province].select(&:present?).join(", ") %>
                </option>
              <% end %>
            </select>
            <button type="button" id="delete-address-btn" class="del-btn" data-confirm="Delete this address?">
              <%= image_tag "trash-bin.svg", size: "16x16", alt: "Delete" %>
            </button>
          </div>
        </div>
      <% end %>

      <button type="button" class="address-trigger-btn" onclick="document.getElementById('address-modal').classList.add('active')">+ Add New Address</button>

      <div class="apf-section apf-section-darken" style="margin-top:1rem">
        <%= f.fields_for :address, addresses.first || @user.address.build do |af| %>
          <%= af.hidden_field :id %>

          <div class="form-group">
            <%= af.label :address_line_1, "Address Line 1<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
            <%= af.text_field :address_line_1, required: true, class: "form-input" %>
          </div>

          <div class="form-group">
            <%= af.label :address_line_2, "Address Line 2" %>
            <%= af.text_field :address_line_2, class: "form-input" %>
          </div>

          <div class="form-group">
            <%= af.label :city, "City<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
            <%= af.text_field :city, required: true, class: "form-input" %>
          </div>

          <div class="form-group">
            <%= af.label :province, "State / Province<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
            <%= af.text_field :province, required: true, class: "form-input" %>
          </div>

          <div class="form-group">
            <%= af.label :postal_code, "Zip / Postal Code<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
            <%= af.text_field :postal_code, required: true, class: "form-input" %>
          </div>

          <div class="form-group">
            <%= af.label :country, "Country<span style='color:red; font-family:Comfortaa'>*</span>".html_safe %>
            <%= af.select :country, Address.countries.keys, { include_blank: "Select a country" }, required: true, class: "form-input" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="form-actions" style="justify-content: space-between;">
      <%= f.submit "Update Profile", class: "btn-primary" %>
      <%= link_to "Go Home", (root_path || ENV['APP_URL'].presence), class: "btn-secondary" %>
    </div>
  <% end %>
</div>

<%= render "address/new", reload: true %>

<script>
  (function() {
    var picker = document.getElementById('address-picker');
    var deleteBtn = document.getElementById('delete-address-btn');
    if (!picker || !deleteBtn) return;

    function currentAddressId() {
      var opt = picker.options[picker.selectedIndex];
      return opt ? opt.dataset.id : null;
    }

    deleteBtn.addEventListener('click', function() {
      var id = currentAddressId();
      if (!id) return;

      if (deleteBtn.dataset.confirm && !window.confirm(deleteBtn.dataset.confirm)) return;

      var form = document.createElement('form');
      form.method = 'POST';
      form.action = '/addresses/' + id;
      form.style.display = 'none';

      var methodInput = document.createElement('input');
      methodInput.type = 'hidden';
      methodInput.name = '_method';
      methodInput.value = 'delete';
      form.appendChild(methodInput);

      var csrfToken = document.querySelector('meta[name="csrf-token"]');
      if (csrfToken) {
        var csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'authenticity_token';
        csrfInput.value = csrfToken.content;
        form.appendChild(csrfInput);
      }

      document.body.appendChild(form);
      form.submit();
    });
  })();
</script>
