<div class="user-profile-container">
  <% cache([@user, @slack_profile, @projects.maximum(:updated_at)], expires_in: 5.minutes) do %>
  <div class="user-profile-header">
    <div style="display:flex; align-items:center; gap:0.75rem;">
      <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap; width:100%;">
        <h1 style="margin:0; display:inline-flex">
          <% if @slack_profile && @slack_profile[:image].present? %>
            <%= image_tag @slack_profile[:image], alt: "#{@user.name} avatar", width: 48, height: 48, style: "border-radius:999px; vertical-align:middle; margin-right:8px;" %>
          <% else %>
            👤
          <% end %>
          <%= @user.name %>
          <% if @user.admin? %>
            <img src="https://icons.hackclub.com/api/icons/red/admin" style="height:3rem; width:auto; position:relative; bottom:-0.75rem;" alt="admin badge" class="nb-admin-badge" title="Admin">
          <% end %>
          <%= render "level" %>
        </h1>
        <% if @user.flagged_for_fraud? && (current_user&.admin? || @user == current_user) %>
          <img src="https://icons.hackclub.com/api/icons/red/forbidden" style="height:2.5rem; width:auto;" alt="fraud badge" title="Fraudulent">
          <span class="fraud-badge">Flagged for Fraud</span>
        <% end %>
      </div>
      <div style="position:relative; top:0; right:8;">
        <%= render "streak" %>
      </div>
    </div>
    <% if @user.name != "Deleted User" %>
      <div class="user-info">
        <div class="info-item">
          <span class="info-label">Member Since</span>
          <span class="info-value"><%= @user.created_at.strftime("%B %d, %Y") %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Total Projects</span>
          <span class="info-value"><%= @projects.size %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Total Ships</span>
          <span class="info-value"><%= @total_ships_count || user_total_ships(@user) %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Total Charm Notches</span>
          <span class="info-value" style="font-family: monospace;"><%= @user.charm_notches.count %></span>
        </div>
      </div>
      <div class="profile-actions">
        <%= link_to "Edit Profile", profile_path, class: "btn-profile" %>
        <%= link_to "Back to Leaderboard", leaderboard_path, class: "btn-profile" %>
        <% if logged_in? && current_user != @user %>
          <%= button_to "Donate Charm Notches", donate_charm_notches_path(@user), class: "btn-profile", style:"font-size:1.2rem; font-family: 'Pixelify Sans';" %>
        <% end %>
      </div>
  </div>
  <% end %>

  <!-- Projects Section -->
  <div class="profile-section">
    <h2>🚀 Projects</h2>
    <% if @projects.any? %>
      <div class="projects-grid">
        <% @projects.each do |project| %>
          <% cache(project) do %>
          <div class="project-card">
            <h3><%= project.name %></h3>
            <div class="project-meta">
              <span>Status: <span class="status-badge <%= project.shipped? ? 'status-shipped' : 'status-unshipped' %>"><%= project.shipped? ? 'Shipped' : 'Unshipped' %></span></span>
              <span>Created: <%= project.created_at.strftime("%b %d, %Y") %></span>
            </div>
            <div class="project-stats">
              <div class="stat">
                <span class="stat-value"><%= project.ships.size %></span>
                <span class="stat-label">Ships</span>
              </div>
              <div class="stat">
                <span class="stat-value"><%= project.devlogs.size %></span>
                <span class="stat-label">Devlogs</span>
              </div>
              <div class="stat">
                <span class="stat-value"><%= credits_total(project) %></span>
                <span class="stat-label">Total Credits</span>
              </div>
            </div>
            <div style="margin-top: 0.75rem;">
              <%= link_to "View Project", project_path(project), class: "btn-profile", style: "padding: 0.5rem 0.75rem; font-size: 0.9rem;" %>
            </div>
          </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h3>No projects yet</h3>
        <p><%= @user.name %> hasn't created any projects yet.</p>
      </div>
    <% end %>
  </div>

  <!-- Ships Section -->
  <div class="profile-section">
    <h2>📦 Ships</h2>

    <% ship_devlogs = @devlogs.select { |d| d.title&.include?("Ship") } %>

    <% if @ships.any? || ship_devlogs.any? %>
      <% if @ships.any? %>
        <div class="ships-list">
          <% @ships.each do |ship| %>
            <% cache([ship, ship.project]) do %>
              <div class="ship-item">
                <div class="ship-info">
                  <strong>Project:</strong> <%= if ship.project.nil? || ship.project.deleted_at.present? 
                      'Project removed'
                    else
                      ship.project.name
                    end %>
                  • <%= ship.shipped_at.strftime("%b %d, %Y") if ship.shipped_at %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <% if ship_devlogs.any? %>
        <div class="devlogs-list" style="margin-top:0.75rem;">
          <% ship_devlogs.each do |devlog| %>
            <% cache(devlog) do %>
              <div class="devlog-item">
                <div class="devlog-info">
                  <span class="devlog-title"><%= devlog.title || "Untitled Devlog" %></span>
                  <span class="devlog-meta">
                    Project: <%= devlog.project&.name || 'Project removed' %>
                    • <%= devlog.log_date.strftime("%b %d, %Y") %>
                  </span>
                </div>
                <span class="devlog-duration"><%= format_duration(devlog.duration_seconds_total.to_i) %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state">
        <h3>No ships yet</h3>
        <p><%= @user.name %> hasn't shipped any projects yet.</p>
      </div>
    <% end %>
  </div>

  <!-- Devlogs Section -->
  <div class="profile-section">
    <h2>📝 Devlogs</h2>
    <% non_ship_devlogs = @devlogs.reject { |d| d.title&.include?("Ship") } %>
    <% if non_ship_devlogs.any? %>
      <div class="devlogs-list">
        <% non_ship_devlogs.each do |devlog| %>
          <% cache(devlog) do %>
            <div class="devlog-item">
              <div class="devlog-info">
                <span class="devlog-title"><%= devlog.title || "Untitled Devlog" %></span>
                <span class="devlog-meta">
                  Project: <%= devlog.project&.name || 'Project removed' %>
                  • <%= devlog.log_date.strftime("%b %d, %Y") %>
                  <% if devlog.ship_request_id %>
                    • Linked to Ship Request <%= devlog.ship_request_id %>
                  <% end %>
                </span>
              </div>
              <span class="devlog-duration"><%= format_duration(devlog.duration_seconds_total.to_i) %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h3>No devlogs yet</h3>
        <p><%= @user.name %> hasn't logged any development time yet.</p>
      </div>
    <% end %>
  </div>
  <% end %>
</div>

